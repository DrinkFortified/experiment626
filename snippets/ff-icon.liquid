{%- comment -%} Line icons, 24px grid, stroke follows currentColor. Param: name {%- endcomment -%}
<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- case name -%}
  {%- when 'dumbbell' -%}<path d="M6.5 6.5v11M17.5 6.5v11M3.5 9v6M20.5 9v6M6.5 12h11"/>
  {%- when 'muscle' -%}<path d="M7 14c-1.5-3 0-8 3.5-8 1.6 0 2 1.3 1.5 2.4-.5 1-1.6 1.1-2.5.6M7 14c2-1.6 5.5-1.8 8 0 2.3 1.6 2.7 4.8.5 6.5-1.9 1.5-7.5 1.5-10-1-1.6-1.6-2.2-4.3-1.5-6"/>
  {%- when 'battery' -%}<rect x="7" y="4" width="10" height="17" rx="2"/><path d="M10 2.5h4M10 9h4M10 13h4M10 17h4"/>
  {%- when 'calendar' -%}<rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4M9 15l2 2 4-4"/>
  {%- when 'shield' -%}<path d="M12 3l7.5 3v5.5c0 4.6-3.2 8.3-7.5 9.5-4.3-1.2-7.5-4.9-7.5-9.5V6z"/><path d="M8.8 12.2l2.2 2.2 4.4-4.6"/>
  {%- when 'drop' -%}<path d="M12 3.5c3.5 4.3 6 7.6 6 10.6a6 6 0 0 1-12 0c0-3 2.5-6.3 6-10.6z"/><path d="M9 14.5a3 3 0 0 0 3 3"/>
  {%- when 'sun' -%}<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/>
  {%- when 'leaf' -%}<path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14z"/><path d="M5 19l7-7"/>
  {%- when 'bolt' -%}<path d="M13 2.5L5 13.5h6l-1 8 8-11h-6z"/>
  {%- when 'scoop' -%}<path d="M4 10h9a4.5 4.5 0 0 1-9 0zM13 11.5l7-4"/>
  {%- else -%}<circle cx="12" cy="12" r="8.5"/><path d="M8.5 12.2l2.4 2.4 4.6-4.8"/>
{%- endcase -%}
</svg>
