<section class="sec p-close" aria-labelledby="close-{{ section.id }}">
  <div class="wrap">
    <h2 id="close-{{ section.id }}" class="display d1">{{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em></h2>
    <p class="lede">{{ section.settings.text }}</p>
    <a class="btn btn--money" href="{{ section.settings.link | default: '/products/everyday' }}">{{ section.settings.button }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Closing call to action",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Read the label." },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "Then pour a glass." },
    { "type": "text", "id": "text", "label": "Text", "default": "Thirty days to decide. If it is not for your family, we will refund you." },
    { "type": "text", "id": "button", "label": "Button", "default": "Shop Everyday" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [ { "name": "Closing call to action" } ]
}
{% endschema %}
