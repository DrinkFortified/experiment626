{%- liquid
  assign photo = section.settings.photo
  if photo == blank and section.settings.photo_file != blank
    assign photo = images[section.settings.photo_file]
  endif
-%}
<section class="sec p-close{% if photo != blank %} p-close--photo{% endif %}" aria-labelledby="close-{{ section.id }}"{% if photo != blank %} data-sp{% endif %}>
  {%- if photo != blank -%}
  <div class="p-close__photo" aria-hidden="true"><img src="{{ photo | image_url: width: 2200 }}" srcset="{{ photo | image_url: width: 900 }} 900w, {{ photo | image_url: width: 1600 }} 1600w, {{ photo | image_url: width: 2200 }} 2200w" sizes="100vw" alt="" width="{{ photo.width | default: 2048 }}" height="{{ photo.height | default: 1530 }}" loading="lazy"></div>
  {%- endif -%}
  <div class="wrap">
    <h2 id="close-{{ section.id }}" class="display d1">{{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em></h2>
    <p class="lede">{{ section.settings.text }}</p>
    <a class="btn btn--money" href="{{ section.settings.link | default: '/products/everyday' }}">{{ section.settings.button }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Closing call to action",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Read the label." },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "Then pour a glass." },
    { "type": "text", "id": "text", "label": "Text", "default": "45 days to decide. If it is not for your family, we will refund you." },
    { "type": "text", "id": "button", "label": "Button", "default": "Shop Everyday" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "image_picker", "id": "photo", "label": "Background photo (person on the right works best)" },
    { "type": "text", "id": "photo_file", "label": "Photo file name in Files (used when Photo is blank)", "default": "hero-brunette-a.png" }
  ],
  "presets": [ { "name": "Closing call to action" } ]
}
{% endschema %}
