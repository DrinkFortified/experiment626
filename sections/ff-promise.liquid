<section class="sec" aria-labelledby="pr-h">
  <div class="wrap">
    <h2 id="pr-h" class="display d2" style="margin-bottom:clamp(32px,4vw,56px)">{{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em></h2>
    <div class="p-promise">
      {%- for block in section.blocks -%}<div {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>{%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promises",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What we promise" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "every order." }
  ],
  "blocks": [ { "type": "promise", "name": "Promise", "settings": [ { "type": "text", "id": "title", "label": "Title", "default": "Every ingredient named" }, { "type": "text", "id": "text", "label": "Text", "default": "With its source. No proprietary blends, ever." } ] } ],
  "presets": [ { "name": "Promises", "blocks": [
    { "type": "promise", "settings": { "title": "Every ingredient named", "text": "With its source. No proprietary blends, ever." } },
    { "type": "promise", "settings": { "title": "Sweetened with monk fruit", "text": "Monk fruit extract and Reb M, as listed on the label." } },
    { "type": "promise", "settings": { "title": "Skip or cancel online", "text": "In your account, before you are billed. No phone call." } },
    { "type": "promise", "settings": { "title": "Thirty days to decide", "text": "Not for your family? We refund you. No return required." } } ] } ]
}
{% endschema %}
