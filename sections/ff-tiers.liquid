<section class="sec" aria-labelledby="save-h">
  <div class="wrap">
    <div class="sec-head"><h2 id="save-h" class="display d2">{{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em></h2><p>{{ section.settings.text }}</p></div>
    <div class="p-tiers">
      {%- for block in section.blocks limit: 3 -%}
        <div class="{% if forloop.last %}is-best{% endif %}" {{ block.shopify_attributes }}><div class="p-tiers__pct num">{{ block.settings.big }}</div><b>{{ block.settings.title }}</b><p>{{ block.settings.text }}</p></div>
      {%- endfor -%}
    </div>
    <div style="margin-top:36px;display:flex;flex-wrap:wrap;gap:10px"><a class="btn btn--money" href="{{ section.settings.link | default: '/products/everyday' }}">{{ section.settings.button }}</a></div>
  </div>
</section>

{% schema %}
{
  "name": "Ways to save",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The more you keep stocked," },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "the more you save." },
    { "type": "text", "id": "text", "label": "Text", "default": "Mix formulas and organic flavors. Skip or cancel online anytime." },
    { "type": "text", "id": "button", "label": "Button", "default": "Start with Everyday" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "blocks": [ { "type": "tier", "name": "Option", "settings": [ { "type": "text", "id": "big", "label": "Big text", "default": "10%" }, { "type": "text", "id": "title", "label": "Title", "default": "Monthly" }, { "type": "text", "id": "text", "label": "Text", "default": "Ships every 30 days." } ] } ],
  "presets": [ { "name": "Ways to save", "blocks": [
    { "type": "tier", "settings": { "big": "Full", "title": "One-time", "text": "$59.00 a pack, no subscription." } },
    { "type": "tier", "settings": { "big": "10%", "title": "Monthly", "text": "$53.10 a pack, ships every 30 days." } },
    { "type": "tier", "settings": { "big": "20%", "title": "Every 3 months", "text": "Ships every 90 days at $47.20 a pack, any number of packs, plus Free Creatine For Life." } } ] } ]
}
{% endschema %}
