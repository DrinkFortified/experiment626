{%- comment -%} Creatine story: the product description, the facts strip and the product's card images. {%- endcomment -%}
<section class="sec cr-details" aria-labelledby="crd-h-{{ section.id }}">
  <div class="wrap">
    <div class="cr-details__grid">
      <div>
        <h2 id="crd-h-{{ section.id }}" class="display d2">{{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em></h2>
        <ul class="cr-strip">
          <li><b>5g</b><span>creatine monohydrate per serving</span></li>
          <li><b>45</b><span>servings per pouch</span></li>
          <li><b>0</b><span>flavors, sweeteners or fillers</span></li>
        </ul>
      </div>
      <div class="cr-details__copy">{{ product.description | remove: '<em>*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</em>' }}</div>
    </div>
    {%- if product.media.size > 1 and section.settings.show_cards -%}
    <div class="cr-cards" role="list" aria-label="More about the creatine">
      {%- for m in product.media offset: 1 limit: 6 -%}
        {%- if m.media_type == 'image' -%}<figure class="cr-card" role="listitem">{{ m.preview_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: m.alt | default: 'Fortified creatine' }}</figure>{%- endif -%}
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Creatine details",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nothing to" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "second-guess." },
    { "type": "checkbox", "id": "show_cards", "label": "Show the product's card images", "default": true }
  ]
}
{% endschema %}
