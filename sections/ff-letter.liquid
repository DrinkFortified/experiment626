<section class="sec" aria-labelledby="letter-h" id="letter-{{ section.id }}">
  <div class="wrap">
    <article class="letter">
      <h2 id="letter-h" class="sr">{{ section.settings.title }}</h2>
      <div class="letter__body">{{ section.settings.body }}</div>
      {%- if section.settings.signature != blank -%}
        {%- comment -%} A signature that writes itself when it scrolls into view. {%- endcomment -%}
        <span class="letter__sign sig" data-sig role="img" aria-label="{{ section.settings.signature | escape }}">
          <svg viewBox="0 0 640 140" aria-hidden="true" focusable="false"><defs><filter id="sig-rough-{{ section.id }}" x="-5%" y="-20%" width="110%" height="140%"><feTurbulence type="fractalNoise" baseFrequency="1.6" numOctaves="2" seed="4" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="2.2"/></filter></defs><text class="sig__t" x="6" y="96" filter="url(#sig-rough-{{ section.id }})">{{ section.settings.signature }}</text></svg>
        </span>
      {%- endif -%}
      {%- if section.settings.more_label != blank -%}
        <p class="letter__more-wrap"><a class="letter__more" href="{{ section.settings.more_link | default: '/pages/ingredients' }}">{{ section.settings.more_label }}</a></p>
      {%- endif -%}
    </article>
  </div>
</section>

{% schema %}
{
  "name": "Letter",
  "settings": [
    { "type": "text", "id": "title", "label": "Hidden title", "default": "A note from Fortified" },
    { "type": "richtext", "id": "body", "label": "Letter", "default": "<p>You're the one who reads the back. Before it goes in the cart. Before it goes in the lunchbox. Before it goes in the people you love.</p><p>You've earned the right to be picky. Your hydration should earn its place too.</p><p>So we put everything on the label. Every ingredient, every source, every milligram. No blend to hide behind. Nothing you'll find out about later.</p><p>Read it. Then pour it.</p>" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "The Fortified family" },
    { "type": "text", "id": "more_label", "label": "Button", "default": "See every ingredient" },
    { "type": "text", "id": "more_link", "label": "Button link", "default": "/pages/ingredients" }
  ],
  "presets": [ { "name": "Letter" } ]
}
{% endschema %}
