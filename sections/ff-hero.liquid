{%- comment -%}
  Hero, two slides that rotate.
  Slide 1 (studio): the two real pouches large, as 3D objects in a soft glow of the
  pack colours, with spec callouts that draw out from the pouch. Drag a pouch, or
  use the button, to turn them over and read the back.
  Slide 2 (navy): subscribe to 3 packs, get Free Creatine For Life of Subscription.
  A faint 3+1 behind three fanned pouches and the creatine, with a turning ring badge.
  Reduced motion: everything rests; turning still works.
{%- endcomment -%}
{%- liquid
  assign show_offer = section.settings.offer_enabled
  assign p_every = section.settings.product_everyday
  if p_every == blank
    assign p_every = all_products['everyday']
  endif
  assign p_energy = section.settings.product_energy
  if p_energy == blank
    assign p_energy = all_products['energy']
  endif
  assign cre_img = section.settings.offer_creatine_image
  assign life = section.settings.life_image
  if life == blank
    assign life = images['Fortified_HP_Hero.png']
  endif
  if life == blank
    assign life = images['hero-energy-stick.png']
  endif
  if life == blank
    assign life = images['hero-energy-stick.jpg']
  endif
  if life == blank
    assign life = images['hero-energy-stick.webp']
  endif
  assign studio_photo = section.settings.photo
  assign studio_src = ''
  assign studio_w = 964
  assign studio_h = 1073
  if studio_photo != blank
    assign studio_src = studio_photo | image_url: width: 1800
    assign studio_w = studio_photo.width
    assign studio_h = studio_photo.height
  else
    assign studio_src = 'ff-hero-brunette.webp' | asset_url
    assign studio_photo = 'builtin'
  endif
  assign show_life = false
  if section.settings.life_enabled and life != blank
    assign show_life = true
  endif
  assign slide_count = 1
  if show_offer
    assign slide_count = slide_count | plus: 1
  endif
  if show_life
    assign slide_count = slide_count | plus: 1
  endif
  assign rotate = false
  if slide_count > 1
    assign rotate = true
  endif
-%}
<section class="p-hero hz{% if rotate %} p-hero--rotate{% endif %}" aria-labelledby="hero-{{ section.id }}"
  {%- if rotate %} data-hero-rotate="{{ section.settings.interval | default: 8 }}" aria-roledescription="carousel" aria-label="Highlights"{% endif %}>
  <div class="p-hero__slides">

    <div class="p-hero__slide hz-slide {% if studio_photo != blank %}hz-slide--life hz-slide--photo{% else %}hz-slide--dark hz-slide--warm{% endif %} is-active" data-hero-slide{% if rotate %} role="group" aria-roledescription="slide" aria-label="1 of {{ slide_count }}"{% endif %}>
      <div class="hz-bg {% if studio_photo != blank %}hz-bg--life{% else %}hz-bg--warm{% endif %}" aria-hidden="true"></div>
      <div class="wrap hz-grid">
        <div class="hz-copy">
          {%- if section.settings.kicker != blank -%}<p class="hz-kicker hz-in" style="--i:0">{{ section.settings.kicker }}</p>{%- endif -%}
          <h1 id="hero-{{ section.id }}" class="display hz-h"><span class="hz-mask"><span class="hz-line">{{ section.settings.heading }}</span></span> <span class="hz-mask"><em class="hz-line" style="--d:.12s">{{ section.settings.heading_accent }}</em></span></h1>
          <p class="lede hz-lede hz-in" style="--i:3">{{ section.settings.text }}</p>
          <div class="p-hero__actions hz-in" style="--i:4">
            {%- if section.settings.button_1 != blank -%}<a class="btn btn--money" tabindex="-1" href="{{ section.settings.link_1 | default: '/products/everyday' }}">{{ section.settings.button_1 }}</a>{%- endif -%}
            {%- if section.settings.button_2 != blank -%}<a class="btn btn--ghost{% if studio_photo == blank %} hz-btn-light{% endif %}" tabindex="-1" href="{{ section.settings.link_2 | default: '/products/energy' }}">{{ section.settings.button_2 }}</a>{%- endif -%}
          </div>
          {%- if section.settings.note != blank -%}<p class="p-hero__note hz-in" style="--i:5">{{ section.settings.note }}</p>{%- endif -%}
          <ul class="hz-notes hz-in" style="--i:6" aria-label="On the label">
            {%- if section.settings.note_1_v != blank -%}<li class="hz-note hz-note--1" style="--n:0"><i class="hz-note__line" aria-hidden="true"></i><span class="hz-note__txt"><small>{{ section.settings.note_1_k }}</small><b>{{ section.settings.note_1_v }}</b></span></li>{%- endif -%}
            {%- if section.settings.note_2_v != blank -%}<li class="hz-note hz-note--2" style="--n:1"><i class="hz-note__line" aria-hidden="true"></i><span class="hz-note__txt"><small>{{ section.settings.note_2_k }}</small><b>{{ section.settings.note_2_v }}</b></span></li>{%- endif -%}
          </ul>
        </div>

        {%- if studio_photo != blank -%}
        <div class="hz-stage hz-stage--life">
          <figure class="hz-life hz-life--studio">
            <img class="hz-life__img" src="{{ studio_src }}" alt="{{ section.settings.photo_alt | escape }}" width="{{ studio_w }}" height="{{ studio_h }}" loading="lazy">
            {%- if studio_photo == 'builtin' -%}
            <span class="hz-play" aria-hidden="true">
              <i class="hz-play__ring"></i>
              <i class="hz-play__spark" style="--x:76%;--y:9%;--d:0s"></i>
              <i class="hz-play__spark hz-play__spark--sm" style="--x:50%;--y:14%;--d:.7s"></i>
              <i class="hz-play__spark" style="--x:86%;--y:33%;--d:1.3s"></i>
              <span class="hz-play__chip hz-play__chip--a" style="--x:24%;--y:30%;--d:.2s"><b>0g</b> sugar</span>
              <span class="hz-play__chip hz-play__chip--b" style="--x:80%;--y:56%;--d:.45s"><b>1,200mg</b> sodium</span>
              <span class="hz-play__chip hz-play__chip--c" style="--x:-22%;--y:80%;--d:.7s">every ingredient <b>named</b></span>
              <svg class="hz-play__arrow" viewBox="0 0 220 140"><path d="M200 20 C 150 10, 70 20, 40 100" pathLength="1"/><path d="M28 82 L40 104 L60 88" pathLength="1"/></svg>
              <span class="hz-play__note">read every word</span>
            </span>
            {%- endif -%}
          </figure>
        </div>
        {%- else -%}
        <div class="hz-stage" data-hx-stage>
          {%- if section.settings.big_value != blank -%}<div class="hz-big hz-big--one" aria-hidden="true">{{ section.settings.big_value }}<span>{{ section.settings.big_unit }}</span></div>{%- if section.settings.big_label != blank -%}<p class="hz-big-label">{{ section.settings.big_label }}</p>{%- endif -%}{%- endif -%}
          <div class="hz-glow" aria-hidden="true"></div>
          <div class="hz-scene" data-hx-scene>
            {%- if p_energy -%}
            <div class="hz-pack hz-pack--a" data-hx-pack>
              {%- render 'ff-burst', flavor: 'orange' -%}
              <div class="hz-rise"><div class="hz-float"><div class="hz-spin" data-hx-spin>{%- render 'ff-bag3d', product: p_energy, flavor: 'orange', width: 1100, loading: 'eager' -%}</div></div></div>
            </div>
            {%- endif -%}
            {%- if p_every -%}
            <div class="hz-pack hz-pack--b" data-hx-pack>
              {%- render 'ff-burst', flavor: 'watermelon' -%}
              <div class="hz-rise"><div class="hz-float"><div class="hz-spin" data-hx-spin>{%- render 'ff-bag3d', product: p_every, flavor: 'watermelon', width: 1100, loading: 'eager' -%}</div></div></div>
            </div>
            {%- endif -%}
          </div>
          <button type="button" class="hz-turn" data-hx-turn aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12a8 8 0 0 1 13.7-5.6M20 4v5h-5M20 12a8 8 0 0 1-13.7 5.6M4 20v-5h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span data-hx-turn-label>Turn it over</span><span class="hz-turn__hint" aria-hidden="true">or drag the pouch</span>
          </button>
        </div>
        {%- endif -%}
      </div>
    </div>
    {%- if show_offer -%}
    <div class="p-hero__slide hz-slide hz-slide--dark" data-hero-slide role="group" aria-roledescription="slide" aria-label="2 of {{ slide_count }}" aria-hidden="true" inert>
      <div class="hz-bg hz-bg--dark" aria-hidden="true"></div>
      <div class="wrap hz-grid">
        <div class="hz-copy">
          {%- if section.settings.offer_eyebrow != blank -%}<p class="hz-kicker hz-in" style="--i:0">{{ section.settings.offer_eyebrow }}</p>{%- endif -%}
          <h2 class="display hz-h hz-h--offer"><span class="hz-mask"><span class="hz-line">{{ section.settings.offer_heading }}</span></span> <span class="hz-mask"><em class="hz-line" style="--d:.12s">{{ section.settings.offer_heading_accent }}</em></span></h2>
          <p class="lede hz-lede hz-in" style="--i:3">{{ section.settings.offer_text }}</p>
          <div class="p-hero__actions hz-in" style="--i:4">
            {%- if section.settings.offer_button_1 != blank -%}<a class="btn btn--money" href="{{ section.settings.offer_link_1 | default: '/products/everyday' }}" tabindex="-1">{{ section.settings.offer_button_1 }}</a>{%- endif -%}
            {%- if section.settings.offer_button_2 != blank -%}<a class="btn btn--ghost hz-btn-light" href="{{ section.settings.offer_link_2 | default: '/products/energy' }}" tabindex="-1">{{ section.settings.offer_button_2 }}</a>{%- endif -%}
          </div>
          {%- if section.settings.offer_note != blank -%}<p class="p-hero__note hz-in" style="--i:5">{{ section.settings.offer_note }}</p>{%- endif -%}
        </div>
        <div class="hz-stage hz-stage--offer">
          <div class="hz-big" aria-hidden="true">3<span>+</span>1</div>
          <div class="hz-offer">
            <div class="hz-trio">
              {%- if p_every -%}<div class="hz-opack" style="--k:0"><div class="hz-rise"><div class="hz-float">{%- render 'ff-bag3d', product: p_every, flavor: 'watermelon', width: 800 -%}</div></div></div>{%- endif -%}
              {%- if p_energy -%}<div class="hz-opack" style="--k:1"><div class="hz-rise"><div class="hz-float">{%- render 'ff-bag3d', product: p_energy, flavor: 'orange', width: 800 -%}</div></div></div>{%- endif -%}
              {%- if p_every -%}<div class="hz-opack" style="--k:2"><div class="hz-rise"><div class="hz-float">{%- render 'ff-bag3d', product: p_every, flavor: 'orange', width: 800 -%}</div></div></div>{%- endif -%}
            </div>
            <div class="hz-gift">
              <div class="hz-rise"><div class="hz-float">
                {%- if cre_img != blank -%}
                  {{ cre_img | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Fortified Creatine Monohydrate pouch' }}
                {%- else -%}
                  {%- assign cre_file = images['Creatine_PDP_01.webp'] -%}
                  {%- if cre_file -%}<span class="hz-crop">{{ cre_file | image_url: width: 1400 | image_tag: loading: 'lazy', alt: 'Fortified Creatine Monohydrate pouch' }}</span>{%- endif -%}
                {%- endif -%}
              </div></div>
              <div class="hz-ring" aria-hidden="true">
                <svg class="hz-ring__text" viewBox="0 0 120 120" focusable="false"><defs><path id="hzc-{{ section.id }}" d="M60,60 m-47,0 a47,47 0 1,1 94,0 a47,47 0 1,1 -94,0"/></defs><text><textPath href="#hzc-{{ section.id }}" textLength="292" lengthAdjust="spacing">FREE CREATINE FOR LIFE OF SUBSCRIPTION &#8226;</textPath></text></svg>
                <span class="hz-ring__core">Free</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    {%- endif -%}
    {%- if show_life -%}
    <div class="p-hero__slide hz-slide hz-slide--life" data-hero-slide role="group" aria-roledescription="slide" aria-label="{{ slide_count }} of {{ slide_count }}" aria-hidden="true" inert>
      <div class="hz-bg hz-bg--life" aria-hidden="true"></div>
      <div class="wrap hz-grid">
        <div class="hz-copy">
          {%- if section.settings.life_kicker != blank -%}<p class="hz-kicker hz-in" style="--i:0">{{ section.settings.life_kicker }}</p>{%- endif -%}
          <h2 class="display hz-h"><span class="hz-mask"><span class="hz-line">{{ section.settings.life_heading }}</span></span> <span class="hz-mask"><em class="hz-line" style="--d:.12s">{{ section.settings.life_heading_accent }}</em></span></h2>
          <p class="lede hz-lede hz-in" style="--i:3">{{ section.settings.life_text }}</p>
          <div class="p-hero__actions hz-in" style="--i:4">
            {%- if section.settings.life_button_1 != blank -%}<a class="btn btn--money" href="{{ section.settings.life_link_1 | default: '/products/energy' }}">{{ section.settings.life_button_1 }}</a>{%- endif -%}
            {%- if section.settings.life_button_2 != blank -%}<a class="btn btn--ghost" href="{{ section.settings.life_link_2 | default: '/products/everyday' }}">{{ section.settings.life_button_2 }}</a>{%- endif -%}
          </div>
        </div>
        <div class="hz-stage hz-stage--life">
          {%- if section.settings.life_big != blank -%}<div class="hz-big hz-big--life" aria-hidden="true">{{ section.settings.life_big }}</div>{%- if section.settings.life_big_label != blank -%}<p class="hz-big-label hz-big-label--life">{{ section.settings.life_big_label }}</p>{%- endif -%}{%- endif -%}
          <figure class="hz-life">
            <img class="hz-life__img" src="{{ life | image_url: width: 1600 }}" alt="{{ section.settings.life_alt | escape }}" width="{{ life.width | default: 707 }}" height="{{ life.height | default: 744 }}" loading="eager" fetchpriority="high">
            {%- if section.settings.life_note_v != blank -%}
            <span class="hz-life__note"><i class="hz-note__line" aria-hidden="true"></i><span class="hz-note__txt"><small>{{ section.settings.life_note_k }}</small><b>{{ section.settings.life_note_v }}</b></span></span>
            {%- endif -%}
          </figure>
        </div>
      </div>
    </div>
    {%- endif -%}

  </div>

  {%- if rotate -%}
  <div class="p-hero__dots hz-dots" role="group" aria-label="Choose a slide">
    {%- for i in (1..slide_count) -%}
      <button type="button" class="p-hero__dot" data-hero-dot="{{ forloop.index0 }}" aria-label="Show slide {{ i }}"{% if forloop.first %} aria-current="true"{% endif %}><i></i></button>
    {%- endfor -%}
    <button type="button" class="p-hero__pause" data-hero-pause aria-label="Pause rotation" aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="i-pause"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
      <svg viewBox="0 0 24 24" aria-hidden="true" class="i-play"><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg>
    </button>
  </div>
  {%- endif -%}
</section>

