{%- comment -%}
  Hero with two slides that rotate: the main hero, and the subscription offer
  (subscribe to 3 packs, get Free Creatine For Life of Subscription).
  Auto-rotation pauses on hover, keyboard focus and hidden tabs, and is off for
  reduced motion. Dots switch slides by hand.
{%- endcomment -%}
{%- liquid
  assign show_offer = section.settings.offer_enabled
  assign cre_img = section.settings.offer_creatine_image
-%}
<section class="p-hero{% if show_offer %} p-hero--rotate{% endif %}" aria-labelledby="hero-{{ section.id }}"
  {%- if show_offer %} data-hero-rotate="{{ section.settings.interval | default: 7 }}" aria-roledescription="carousel" aria-label="Highlights"{% endif %}>
  <div class="wrap">
    <div class="p-hero__slides">
      <div class="p-hero__slide is-active" data-hero-slide{% if show_offer %} role="group" aria-roledescription="slide" aria-label="1 of 2"{% endif %}>
        <div class="p-hero__top">
          <h1 id="hero-{{ section.id }}" class="display d1" data-enter>{{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em></h1>
          <div class="p-hero__aside" data-enter style="--d:120ms">
            <p class="lede">{{ section.settings.text }}</p>
            <div class="p-hero__actions">
              {%- if section.settings.button_1 != blank -%}<a class="btn btn--money" href="{{ section.settings.link_1 | default: '/products/everyday' }}">{{ section.settings.button_1 }}</a>{%- endif -%}
              {%- if section.settings.button_2 != blank -%}<a class="btn btn--ghost" href="{{ section.settings.link_2 | default: '/products/energy' }}">{{ section.settings.button_2 }}</a>{%- endif -%}
            </div>
            {%- if section.settings.note != blank -%}<p class="p-hero__note">{{ section.settings.note }}</p>{%- endif -%}
          </div>
        </div>
        <figure class="set p-hero__set" data-enter style="--d:200ms">
          {%- if section.settings.photo != blank -%}
            {{ section.settings.photo | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', style: 'width:100%;height:100%;object-fit:cover', sizes: '100vw' }}
          {%- else -%}
            <div class="set__packs set__packs--hero">
              <img class="set__stick" src="{{ 'ff-energy-watermelon-stick.webp' | asset_url }}" alt="" width="300" height="1075">
              <div class="set__pack"><img src="{{ 'ff-energy-orange-front.webp' | asset_url }}" alt="Fortified Energy pouch" width="885" height="900" fetchpriority="high"></div>
              <div class="set__pack set__pack--lead"><img src="{{ 'ff-everyday-watermelon-front.webp' | asset_url }}" alt="Fortified Everyday pouch" width="885" height="900" fetchpriority="high"></div>
              <img class="set__stick set__stick--r" src="{{ 'ff-everyday-orange-stick.webp' | asset_url }}" alt="" width="300" height="1075">
            </div>
          {%- endif -%}
          {%- if section.settings.sticker_1 != blank -%}<span class="sticker sticker--a"><span><b>{{ section.settings.sticker_1 }}</b>{{ section.settings.sticker_1_sub }}</span></span>{%- endif -%}
          {%- if section.settings.sticker_2 != blank -%}<span class="sticker sticker--b"><span><b>{{ section.settings.sticker_2 }}</b>{{ section.settings.sticker_2_sub }}</span></span>{%- endif -%}
        </figure>
      </div>

      {%- if show_offer -%}
      <div class="p-hero__slide p-hero__slide--offer" data-hero-slide role="group" aria-roledescription="slide" aria-label="2 of 2" aria-hidden="true" inert>
        <div class="p-hero__top">
          <div>
            {%- if section.settings.offer_eyebrow != blank -%}<p class="p-hero__eyebrow">{{ section.settings.offer_eyebrow }}</p>{%- endif -%}
            <h2 class="display d1 p-hero__offer-h">{{ section.settings.offer_heading }} <em>{{ section.settings.offer_heading_accent }}</em></h2>
          </div>
          <div class="p-hero__aside">
            <p class="lede">{{ section.settings.offer_text }}</p>
            <div class="p-hero__actions">
              {%- if section.settings.offer_button_1 != blank -%}<a class="btn btn--money" href="{{ section.settings.offer_link_1 | default: '/products/everyday' }}" tabindex="-1">{{ section.settings.offer_button_1 }}</a>{%- endif -%}
              {%- if section.settings.offer_button_2 != blank -%}<a class="btn btn--ghost" href="{{ section.settings.offer_link_2 | default: '/products/energy' }}" tabindex="-1">{{ section.settings.offer_button_2 }}</a>{%- endif -%}
            </div>
            {%- if section.settings.offer_note != blank -%}<p class="p-hero__note">{{ section.settings.offer_note }}</p>{%- endif -%}
          </div>
        </div>
        <figure class="set p-hero__set p-hero__set--offer">
          <div class="offer-row">
            <div class="offer-row__packs">
              <div class="offer-row__pack"><img src="{{ 'ff-everyday-watermelon-front.webp' | asset_url }}" alt="Everyday Organic Salty Watermelon pouch" width="885" height="900" loading="lazy"><span class="offer-row__n">1</span></div>
              <div class="offer-row__pack"><img src="{{ 'ff-energy-orange-front.webp' | asset_url }}" alt="Energy Organic Salty Orange pouch" width="885" height="900" loading="lazy"><span class="offer-row__n">2</span></div>
              <div class="offer-row__pack"><img src="{{ 'ff-everyday-orange-front.webp' | asset_url }}" alt="Everyday Organic Salty Orange pouch" width="885" height="900" loading="lazy"><span class="offer-row__n">3</span></div>
            </div>
            <span class="offer-row__plus" aria-hidden="true">+</span>
            <div class="offer-row__gift">
              {%- if cre_img != blank -%}
                {{ cre_img | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Fortified Creatine Monohydrate pouch' }}
              {%- else -%}
                {%- assign cre_file = images['Creatine_PDP_01.webp'] -%}
                {%- if cre_file -%}<span class="offer-row__crop">{{ cre_file | image_url: width: 1200 | image_tag: loading: 'lazy', alt: 'Fortified Creatine Monohydrate pouch' }}</span>{%- endif -%}
              {%- endif -%}
              <span class="offer-row__free">Free</span>
            </div>
          </div>
          <figcaption class="offer-row__cap"><span>3 subscription packs</span><span>{{ section.settings.offer_caption }}</span></figcaption>
        </figure>
      </div>
      {%- endif -%}
    </div>

    {%- if show_offer -%}
    <div class="p-hero__dots" role="group" aria-label="Choose a slide">
      <button type="button" class="p-hero__dot" data-hero-dot="0" aria-label="Show slide 1" aria-current="true"><i></i></button>
      <button type="button" class="p-hero__dot" data-hero-dot="1" aria-label="Show slide 2: {{ section.settings.offer_caption | escape }}"><i></i></button>
      <button type="button" class="p-hero__pause" data-hero-pause aria-label="Pause rotation" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="i-pause"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="i-play"><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg>
      </button>
    </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "header", "content": "Slide 1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Electrolytes with" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "nothing to hide." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A short list of ingredients you can name, sweetened with monk fruit, for the mom who turns the pack over before it reaches her family." },
    { "type": "text", "id": "button_1", "label": "Button 1", "default": "Shop Everyday" },
    { "type": "url", "id": "link_1", "label": "Button 1 link" },
    { "type": "text", "id": "button_2", "label": "Button 2", "default": "Shop Energy" },
    { "type": "url", "id": "link_2", "label": "Button 2 link" },
    { "type": "text", "id": "note", "label": "Note", "default": "Save 20% every 3 months. Skip or cancel online." },
    { "type": "image_picker", "id": "photo", "label": "Lifestyle photo (replaces the pack scene)" },
    { "type": "text", "id": "sticker_1", "label": "Sticker 1 big", "default": "0g" },
    { "type": "text", "id": "sticker_1_sub", "label": "Sticker 1 small", "default": "sugar" },
    { "type": "text", "id": "sticker_2", "label": "Sticker 2 big", "default": "No" },
    { "type": "text", "id": "sticker_2_sub", "label": "Sticker 2 small", "default": "dyes" },
    { "type": "header", "content": "Slide 2: subscription offer" },
    { "type": "checkbox", "id": "offer_enabled", "label": "Show and rotate the offer slide", "default": true },
    { "type": "range", "id": "interval", "label": "Seconds per slide", "min": 4, "max": 15, "step": 1, "unit": "s", "default": 7 },
    { "type": "text", "id": "offer_eyebrow", "label": "Eyebrow", "default": "Subscription offer" },
    { "type": "text", "id": "offer_heading", "label": "Heading", "default": "Subscribe to 3 packs, get" },
    { "type": "text", "id": "offer_heading_accent", "label": "Heading accent", "default": "Free Creatine For Life of Subscription." },
    { "type": "textarea", "id": "offer_text", "label": "Text", "default": "Mix Everyday and Energy in any organic flavor, Monthly or Every 3 months. A pouch of pure creatine monohydrate comes free with every delivery for as long as you stay subscribed." },
    { "type": "text", "id": "offer_button_1", "label": "Button 1", "default": "Build your 3" },
    { "type": "url", "id": "offer_link_1", "label": "Button 1 link" },
    { "type": "text", "id": "offer_button_2", "label": "Button 2", "default": "Shop Energy" },
    { "type": "url", "id": "offer_link_2", "label": "Button 2 link" },
    { "type": "text", "id": "offer_note", "label": "Note", "default": "Added to your box automatically at 3 subscription packs. Skip or cancel online anytime." },
    { "type": "text", "id": "offer_caption", "label": "Caption under the creatine", "default": "Free Creatine For Life of Subscription" },
    { "type": "image_picker", "id": "offer_creatine_image", "label": "Creatine image (blank uses Creatine_PDP_01.webp from Files)" }
  ],
  "presets": [ { "name": "Fortified hero" } ]
}
{% endschema %}
