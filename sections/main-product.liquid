{%- comment -%}
  Product buy page. Structure: name, one-line description, savings bar, a stepper
  per organic flavor of this formula, then the other formula's flavors underneath
  (Everyday shows Energy, Energy shows Everyday), purchase toggle
  (Monthly / Every 3 months / One-time), plain-text plan note, order summary, Add.
  Every 3 months is only a delivery frequency: any number of packs.
  Images: the transparent pouch render ("Front" image) for each flavor.
{%- endcomment -%}
{%- liquid
  assign formula = section.settings.formula
  if formula == 'auto'
    if product.handle contains 'energy'
      assign formula = 'energy'
    else
      assign formula = 'everyday'
    endif
  endif
  if formula == 'energy'
    assign other_handle = section.settings.other_handle | default: 'everyday'
    assign this_label = 'Energy'
    assign other_label = 'Everyday'
    assign badge = section.settings.badge | default: 'Caffeine'
    assign line = section.settings.line | default: '150mg natural caffeine from coffee bean, plus electrolytes.'
    assign other_line = 'Caffeine-free, with Vitamin D3 and K2.'
  else
    assign other_handle = section.settings.other_handle | default: 'energy'
    assign this_label = 'Everyday'
    assign other_label = 'Energy'
    assign badge = section.settings.badge | default: 'Caffeine-free'
    assign line = section.settings.line | default: 'Caffeine-free electrolytes with Vitamin D3 and K2.'
    assign other_line = '150mg caffeine from coffee bean.'
  endif
  assign other = all_products[other_handle]
  if other.id == product.id
    assign other = nil
  endif
  assign short_title = product.title | split: ' by ' | first | split: ' Hydration' | first | split: ' Electrolyte' | first
  assign heading = section.settings.heading | default: short_title
  capture plans
    render 'ff-plan-ids', product: product
  endcapture
  assign plan_parts = plans | split: '|'
  assign monthly_pct = plan_parts[2]
  assign quarterly_pct = plan_parts[3]
-%}

<div data-product data-flavor-mode>
<section class="pd" aria-labelledby="pd-h-{{ section.id }}">
  <div class="pd__stage field--{{ formula }}" data-field>
    <div class="pd__crumbs"><a href="{{ routes.root_url }}">Home</a> / {{ heading | escape }}</div>
    <span class="tag pd__tag">{{ badge }}</span>
    <div class="pd__stack" data-pd-stack>
      {%- assign gift_img = images['Creatine_PDP_01.webp'] -%}
      {%- if gift_img -%}
      <figure class="pd__gift" data-pd-gift hidden>
        <span class="hz-crop">{{ gift_img | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'Free creatine pouch' }}</span>
        <span class="pd__gift-badge">Free</span>
        <figcaption class="sr">Free Creatine For Life of Subscription included</figcaption>
      </figure>
      {%- endif -%}
      {%- for variant in product.variants -%}
        {%- capture src -%}{%- render 'ff-pouch-image', product: product, variant: variant, width: 1000 -%}{%- endcapture -%}
        <figure class="pd__stackpack" data-stack="{{ variant.id }}">
          <div class="pack pack--bare">{%- if src != blank -%}<img src="{{ src }}" alt="{{ this_label }} {{ variant.title | escape }} pouch" width="1000" height="1017"{% if forloop.first %} fetchpriority="high"{% else %} loading="lazy"{% endif %}>{%- endif -%}</div>
          <span class="pd__count num" aria-hidden="true"></span>
          <figcaption>{{ this_label }} &middot; {{ variant.title }}</figcaption>
        </figure>
      {%- endfor -%}
      {%- if other -%}
        {%- for variant in other.variants -%}
          {%- capture src -%}{%- render 'ff-pouch-image', product: other, variant: variant, width: 1000 -%}{%- endcapture -%}
          <figure class="pd__stackpack is-out" data-stack="{{ variant.id }}">
            <div class="pack pack--bare">{%- if src != blank -%}<img src="{{ src }}" alt="{{ other_label }} {{ variant.title | escape }} pouch" width="1000" height="1017" loading="lazy">{%- endif -%}</div>
            <span class="pd__count num" aria-hidden="true"></span>
            <figcaption>{{ other_label }} &middot; {{ variant.title }}</figcaption>
          </figure>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  <div class="pd__buy" id="buy" tabindex="-1">
    <h1 id="pd-h-{{ section.id }}" class="display d1 pd__h"><span class="pd__h-type">{% if formula == 'energy' %}Electrolyte drink mix with natural caffeine{% else %}Electrolyte drink mix with Vitamin D3 + K2{% endif %}</span>{{ heading }}</h1>
    <p class="lede">{{ line }}</p>

    <div class="tiers" data-tiers aria-label="Savings">
      <ol class="tiers__steps">
        <li data-tier="1"><i class="tiers__seg" aria-hidden="true"></i><b>Monthly</b><span>{{ monthly_pct }}% off</span></li>
        <li data-tier="2"><i class="tiers__seg" aria-hidden="true"></i><b>2+ packs</b><span>15% off + Free Shipping</span></li>
        <li data-tier="3"><i class="tiers__seg" aria-hidden="true"></i><b>Every 3 months</b><span>{{ quarterly_pct }}% off</span></li>
      </ol>
      <span class="tiers__gift" data-tiers-gift aria-hidden="true"><img src="{{ 'ff-creatine-cutout.webp' | asset_url }}" alt="" width="721" height="900" loading="lazy"><b>Free</b></span>
      <p class="tiers__msg" data-tiers-msg aria-live="polite"></p>
    </div>

    {%- form 'product', product, class: 'pd__opts', data-ff-form: '' -%}
      <div class="opt"><div class="opt__label">{{ this_label }} &middot; {{ 'product.flavors' | t }} <span class="opt__aside" data-pd-perk></span></div>
        <div class="flavor-rows">
          {%- for variant in product.variants -%}
            {%- assign q = 0 -%}
            {%- render 'ff-flavor-row', product: product, variant: variant, qty: q, formula_label: '' -%}
          {%- endfor -%}
        </div></div>

      {%- if other -%}
        <div class="opt opt--other"><div class="opt__label">Add {{ other_label }} <span class="opt__aside opt__aside--quiet">{{ other_line }}</span></div>
          <div class="flavor-rows">
            {%- for variant in other.variants -%}
              {%- render 'ff-flavor-row', product: other, variant: variant, qty: 0, formula_label: other_label -%}
            {%- endfor -%}
          </div></div>
      {%- endif -%}

      <div class="opt"><div class="opt__label">{{ 'product.purchase' | t }}</div>
        <p class="plan-note" data-plan-note aria-live="polite"></p>
        <div class="seg seg--full" role="group" aria-label="Purchase type" data-pp>
          {%- if plan_parts[0] != blank -%}<button type="button" data-v="sub" aria-pressed="true"><span>Monthly</span><small class="num" data-plan-price="sub"></small></button>{%- endif -%}
          {%- if plan_parts[1] != blank -%}<button type="button" data-v="q3" aria-pressed="false" class="pp-q3"><span>Every 3 months</span><small class="num" data-plan-price="q3"></small></button>{%- endif -%}
          {%- unless product.requires_selling_plan -%}<button type="button" data-v="otp" aria-pressed="{% if plan_parts[0] == blank %}true{% else %}false{% endif %}"><span>One-time</span><small class="num" data-plan-price="otp"></small></button>{%- endunless -%}
        </div></div>

      <div class="sheet-wrap pd-receipt">
        <div class="sheet">
          <div class="pd-receipt__head"><b>Your order</b><span data-pd-receipt-meta></span></div>
          <ul class="items" data-pd-receipt aria-live="polite"></ul>
          <div class="totals"><div class="total-row total-row--big"><span>Total</span><span class="num" data-pd-price></span></div></div>
          <span class="pd__save num" data-pd-save></span>
        </div>
      </div>
      <button class="btn btn--money btn--block" type="submit" data-pd-add>{{ 'product.add' | t }}</button>
      <p class="pd__error" data-pd-error role="alert" hidden></p>
      {%- render 'ff-trust-row' -%}
    {%- endform -%}

    {%- for block in section.blocks -%}{% render block %}{%- endfor -%}
    {%- if section.settings.reviews_line != blank -%}<div class="pd-proof">{{ section.settings.reviews_line }}</div>{%- endif -%}
    {%- if section.settings.caution != blank -%}<p class="pd__fine">{{ section.settings.caution }}</p>{%- endif -%}
  </div>
</section>

{%- capture other_plans -%}{%- if other -%}{%- render 'ff-plan-ids', product: other -%}{%- endif -%}{%- endcapture -%}
{%- assign other_parts = other_plans | split: '|' -%}
<script type="application/json" data-product-json>
{
  "formula": {{ formula | json }},
  "monthlyPct": {{ monthly_pct | default: 0 | json }},
  "quarterlyPct": {{ quarterly_pct | default: 0 | json }},
  "volumeTiers": {{ settings.volume_tiers | json }},
  "variants": [
    {%- for variant in product.variants -%}
    { "id": {{ variant.id }}, "formula": {{ this_label | json }}, "title": {{ variant.title | json }}, "available": {{ variant.available | json }}, "price": {{ variant.price }},
      "monthly": {{ plan_parts[0] | json }}, "quarterly": {{ plan_parts[1] | json }},
      "plans": { {%- for a in variant.selling_plan_allocations -%}{{ a.selling_plan.id | append: '' | json }}: {{ a.price }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} } }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
    {%- if other -%}
      {%- for variant in other.variants -%}
    ,{ "id": {{ variant.id }}, "formula": {{ other_label | json }}, "title": {{ variant.title | json }}, "available": {{ variant.available | json }}, "price": {{ variant.price }},
      "monthly": {{ other_parts[0] | json }}, "quarterly": {{ other_parts[1] | json }},
      "plans": { {%- for a in variant.selling_plan_allocations -%}{{ a.selling_plan.id | append: '' | json }}: {{ a.price }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} } }
      {%- endfor -%}
    {%- endif -%}
  ]
}
</script>
</div>

{% schema %}
{
  "name": "Product buy box",
  "settings": [
    { "type": "select", "id": "formula", "label": "Formula", "default": "auto", "options": [ { "value": "auto", "label": "From product handle" }, { "value": "everyday", "label": "Everyday (orange)" }, { "value": "energy", "label": "Energy (sky)" } ] },
    { "type": "text", "id": "other_handle", "label": "Other formula product handle (blank: automatic)", "info": "Shown underneath this formula so both can go in one order." },
    { "type": "text", "id": "heading", "label": "Heading (blank uses the short product title)" },
    { "type": "text", "id": "line", "label": "One-line description (blank uses the formula default)" },
    { "type": "text", "id": "badge", "label": "Badge (blank uses the formula default)" },
    { "type": "richtext", "id": "reviews_line", "label": "Reviews line" },
    { "type": "text", "id": "caution", "label": "Caution", "default": "As printed on the pack: consult your healthcare professional before use if you are pregnant, nursing, taking medication or have a medical condition. Energy contains caffeine." }
  ],
  "blocks": [ { "type": "@app" } ]
}
{% endschema %}
