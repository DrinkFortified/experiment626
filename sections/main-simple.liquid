{%- comment -%} Used by 404, search, list-collections, blog and article templates. {%- endcomment -%}
<section class="sec" style="padding-top:clamp(48px,6vw,96px)">
  <div class="wrap" style="max-width:820px">
    {%- case template.name -%}
      {%- when '404' -%}
        <h1 class="display d2">Page not found.</h1>
        <p class="lede">The page you were looking for isn&rsquo;t here.</p>
        <p style="margin-top:24px"><a class="btn btn--money" href="{{ routes.root_url }}">Back home</a></p>
      {%- when 'search' -%}
        <h1 class="display d2">Search</h1>
        <form action="{{ routes.search_url }}" method="get" role="search" class="news" style="max-width:520px;margin-top:20px">
          <label class="sr" for="q">Search</label><input id="q" type="search" name="q" value="{{ search.terms | escape }}" style="color:var(--ink);border-color:var(--edge)"><button class="btn btn--money" type="submit">Search</button>
        </form>
        {%- if search.performed -%}
          <ul style="margin-top:28px;display:grid;gap:12px;list-style:none;padding:0">
            {%- for item in search.results -%}<li><a class="link" href="{{ item.url }}">{{ item.title }}</a></li>{%- else -%}<li>No results.</li>{%- endfor -%}
          </ul>
        {%- endif -%}
      {%- when 'list-collections' -%}
        <h1 class="display d2">Collections</h1>
        <ul style="margin-top:24px;display:grid;gap:12px;list-style:none;padding:0">{%- for c in collections -%}<li><a class="link" href="{{ c.url }}">{{ c.title }}</a></li>{%- endfor -%}</ul>
      {%- when 'blog' -%}
        <h1 class="display d2">{{ blog.title }}</h1>
        {%- paginate blog.articles by 10 -%}
          <ul style="margin-top:24px;display:grid;gap:16px;list-style:none;padding:0">{%- for a in blog.articles -%}<li><a class="link" href="{{ a.url }}">{{ a.title }}</a><br><small>{{ a.published_at | date: '%B %-d, %Y' }}</small></li>{%- endfor -%}</ul>
          {%- if paginate.pages > 1 -%}{{ paginate | default_pagination }}{%- endif -%}
        {%- endpaginate -%}
      {%- when 'article' -%}
        <h1 class="display d2">{{ article.title }}</h1>
        <p class="small-label" style="margin-top:12px">{{ article.published_at | date: '%B %-d, %Y' }}</p>
        <div class="rte lede" style="max-width:none;margin-top:24px">{{ article.content }}</div>
      {%- else -%}
        <h1 class="display d2">{{ page_title }}</h1>
    {%- endcase -%}
  </div>
</section>
{% schema %}
{ "name": "Simple page", "settings": [] }
{% endschema %}
