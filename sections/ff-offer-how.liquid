{%- comment -%}
  How the Free Creatine offer works (3 steps) and what it is worth over a year.
  The value uses the creatine product's live price: 12 deliveries a year on Monthly,
  4 on Every 3 months.
{%- endcomment -%}
{%- liquid
  assign cre = all_products[section.settings.creatine_handle]
  assign p = cre.price | default: 2950
  assign yr_m = p | times: 12
  assign yr_q = p | times: 4
  capture plans
    render 'ff-plan-ids', product: all_products['everyday']
  endcapture
  assign q_pct = plans | split: '|' | last | default: 20
-%}
<section class="ofh" data-crf data-sp aria-labelledby="ofh-h-{{ section.id }}">
  <div class="wrap">
    <p class="ofh__eye">How it works</p>
    <h2 id="ofh-h-{{ section.id }}" class="crf__h crf__h--center ofh__h">{{ section.settings.heading }}</h2>
    <ol class="ofh__steps">
      <li style="--i:0"><span class="ofh__n">1</span><h3>Pick 3 or more packs</h3><p>Mix Everyday and Energy in any flavor. 30 stick packs in each.</p></li>
      <li style="--i:1"><span class="ofh__n">2</span><h3>Choose Monthly or Every 3 months</h3><p>Save on every pack. Free Shipping on every delivery. Skip, swap or cancel online.</p></li>
      <li style="--i:2"><span class="ofh__n">3</span><h3>Creatine ships free</h3><p>A pouch of pure creatine monohydrate is added to every delivery, for as long as you stay subscribed.</p></li>
    </ol>

    <div class="ofh__value">
      <div class="ofh__value-copy">
        <p class="ofh__eye ofh__eye--dark">What the creatine is worth</p>
        <p class="ofh__value-line">One pouch is <b class="num">{{ p | money_without_trailing_zeros }}</b>. Over a year of deliveries that adds up:</p>
      </div>
      <div class="ofh__cards">
        <div class="ofh__card"><small>Monthly</small><b class="num" data-countup>{{ yr_m | money_without_trailing_zeros }}</b><span>12 free pouches a year</span></div>
        <div class="ofh__card ofh__card--best"><small>Every 3 months</small><b class="num" data-countup>{{ yr_q | money_without_trailing_zeros }}</b><span>4 free pouches a year, plus {{ q_pct }}% off every pack</span></div>
      </div>
      <p class="ofh__fine">Based on the regular price of a creatine pouch and a full year of deliveries. Skip or cancel and the free pouch stops with your subscription.</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Offer: how it works",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps. Free creatine." },
    { "type": "text", "id": "creatine_handle", "label": "Creatine product handle", "default": "creatine-v2" }
  ],
  "presets": [ { "name": "Offer: how it works" } ]
}
{% endschema %}
