{%- comment -%}
  Free Creatine offer band: the woman holding the creatine pouch, the offer in three lines and
  one button. On product pages the button scrolls up to the buy box; elsewhere it links to the
  Free Creatine page (falls back to Everyday until that page is published).
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign cre = all_products[st.creatine_handle]
  assign price = cre.price | default: 2950
  assign yr = price | times: 12
  assign photo = st.image
  assign photo_src = ''
  if photo != blank
    assign photo_src = photo | image_url: width: 1600
    assign pw = photo.width
    assign ph = photo.height
  else
    assign photo_src = 'ff-creatine-model.webp' | asset_url
    assign pw = 1157
    assign ph = 1400
  endif
  assign on_pdp = false
  if product != blank and st.pdp_scroll
    assign on_pdp = true
  endif
  assign link = st.link
  if link == blank
    assign lp = pages['free-creatine']
    if lp != blank and lp.url != blank
      assign link = lp.url
    else
      assign link = '/products/everyday'
    endif
  endif
-%}
{%- if st.only_handle == blank or product == blank or product.handle contains st.only_handle -%}
<section class="cof" data-crf data-sp aria-labelledby="cof-h-{{ section.id }}">
  <div class="wrap cof__grid">
    <div class="cof__copy">
      <p class="cof__eye">{{ st.eyebrow }}</p>
      <h2 id="cof-h-{{ section.id }}" class="crf__h cof__h">{{ st.heading }}</h2>
      <p class="cof__accent">Free creatine with every delivery, for as long as you're subscribed.</p>
      <ol class="cof__steps">
        <li style="--i:0"><b>3+ packs</b><span>Any mix of Everyday and Energy, any flavor.</span></li>
        <li style="--i:1"><b>Subscribe</b><span>Monthly or Every 3 months. Skip or cancel online.</span></li>
        <li class="cof__step--free" style="--i:2"><b>Creatine, free</b><span><s class="num">{{ price | money_without_trailing_zeros }}</s> <b>FREE</b> pouch with every delivery.</span><img class="cof__step-img" src="{{ 'ff-creatine-cutout.webp' | asset_url }}" alt="" width="721" height="900" loading="lazy"></li>
      </ol>
      <div class="cof__actions">
        {%- if on_pdp -%}
          <a class="btn btn--money cof__cta" href="#buy" data-to-buy>{{ st.cta_pdp }}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 19V5M5 12l7-7 7 7"/></svg></a>
        {%- else -%}
          <a class="btn btn--money cof__cta" href="{{ link }}">{{ st.cta }}</a>
        {%- endif -%}
        <span class="cof__value">Up to <b class="num" data-countup>{{ yr | money_without_trailing_zeros }}</b> of creatine a year on Monthly</span>
      </div>
    </div>
    <figure class="cof__photo">
      <span class="cof__ring" aria-hidden="true"></span>
      <span class="cof__pic">
        <img src="{{ photo_src }}" alt="{{ st.alt | escape }}" width="{{ pw }}" height="{{ ph }}" loading="lazy">
        <span class="cof__seal" aria-hidden="true" style="--sx:{{ st.seal_x }}%;--sy:{{ st.seal_y }}%">
          <svg class="cof__seal-back" viewBox="-6 -6 112 112"><path d="M57.6 6.7 Q68.1 0.2 72.0 11.9 Q84.1 9.4 83.7 21.7 Q95.9 23.5 91.3 35.0 Q102.2 40.8 94.0 50.0 Q102.2 59.2 91.3 65.0 Q95.9 76.5 83.7 78.3 Q84.1 90.6 72.0 88.1 Q68.1 99.8 57.6 93.3 Q50.0 103.0 42.4 93.3 Q31.9 99.8 28.0 88.1 Q15.9 90.6 16.3 78.3 Q4.1 76.5 8.7 65.0 Q-2.2 59.2 6.0 50.0 Q-2.2 40.8 8.7 35.0 Q4.1 23.5 16.3 21.7 Q15.9 9.4 28.0 11.9 Q31.9 0.2 42.4 6.7 Q50.0 -3.0 57.6 6.7 Z"/></svg>
          <svg class="cof__seal-front" viewBox="0 0 100 100"><path d="M57.6 6.7 Q68.1 0.2 72.0 11.9 Q84.1 9.4 83.7 21.7 Q95.9 23.5 91.3 35.0 Q102.2 40.8 94.0 50.0 Q102.2 59.2 91.3 65.0 Q95.9 76.5 83.7 78.3 Q84.1 90.6 72.0 88.1 Q68.1 99.8 57.6 93.3 Q50.0 103.0 42.4 93.3 Q31.9 99.8 28.0 88.1 Q15.9 90.6 16.3 78.3 Q4.1 76.5 8.7 65.0 Q-2.2 59.2 6.0 50.0 Q-2.2 40.8 8.7 35.0 Q4.1 23.5 16.3 21.7 Q15.9 9.4 28.0 11.9 Q31.9 0.2 42.4 6.7 Q50.0 -3.0 57.6 6.7 Z"/><circle cx="50" cy="50" r="36" /></svg>
          <span class="cof__seal-txt"><b>FREE</b><small>every delivery</small></span>
        </span>
      </span>
    </figure>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Free Creatine offer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Free Creatine offer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Keep 3 packs coming. Your creatine is on us." },
    { "type": "image_picker", "id": "image", "label": "Photo (transparent cutout works best)", "info": "Blank uses the built-in photo." },
    { "type": "text", "id": "alt", "label": "Photo description", "default": "A woman holding a pouch of Fortified Creatine Monohydrate" },
    { "type": "text", "id": "cta", "label": "Button", "default": "Build my box" },
    { "type": "url", "id": "link", "label": "Button link", "info": "Blank uses the Free Creatine page once it is published, otherwise Everyday." },
    { "type": "checkbox", "id": "pdp_scroll", "label": "On product pages, scroll up to the buy box instead", "default": true },
    { "type": "text", "id": "cta_pdp", "label": "Button on product pages", "default": "Build my 3 pack box" },
    { "type": "text", "id": "creatine_handle", "label": "Creatine product handle", "default": "creatine-v2" },
    { "type": "text", "id": "only_handle", "label": "On product pages, only show when the handle contains" },
    { "type": "range", "id": "seal_x", "label": "Seal position across the photo (%)", "min": 0, "max": 100, "step": 1, "default": 14 },
    { "type": "range", "id": "seal_y", "label": "Seal position down the photo (%)", "min": 0, "max": 100, "step": 1, "default": 13 }
  ],
  "presets": [ { "name": "Free Creatine offer" } ]
}
{% endschema %}
