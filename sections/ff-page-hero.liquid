{%- comment -%}
  Page hero for content pages (About, Ingredients, Help). Eyebrow, H1, text (blank uses the
  page's own content), up to 3 stat chips, buttons, optional jump links and a photo.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign photo = st.image
  if photo == blank and st.image_file != blank
    assign photo = images[st.image_file]
  endif
  assign asset_src = ''
  if photo == blank and st.asset != blank
    assign asset_src = st.asset | asset_url
  endif
  assign links = section.blocks | where: 'type', 'link'
  assign chips = section.blocks | where: 'type', 'chip'
-%}
<section class="iph iph--{{ st.tone }}{% if photo != blank or asset_src != '' %} iph--img{% endif %}" aria-labelledby="iph-h-{{ section.id }}" data-crf>
  <div class="wrap iph__grid">
    <div class="iph__copy">
      {%- if st.eyebrow != blank -%}<p class="iph__eye">{{ st.eyebrow }}</p>{%- endif -%}
      <h1 id="iph-h-{{ section.id }}" class="display d1 iph__h">{{ st.heading | default: page.title }}{% if st.heading_accent != blank %} <em>{{ st.heading_accent }}</em>{% endif %}</h1>
      {%- if st.text != blank -%}
        <div class="lede iph__text">{{ st.text }}</div>
      {%- elsif page.content != blank -%}
        <div class="lede iph__text">{{ page.content }}</div>
      {%- endif -%}
      {%- if chips.size > 0 -%}
      <ul class="iph__chips" role="list">
        {%- for b in chips -%}<li style="--i:{{ forloop.index0 }}" {{ b.shopify_attributes }}><b class="num">{{ b.settings.value }}</b><span>{{ b.settings.label }}</span></li>{%- endfor -%}
      </ul>
      {%- endif -%}
      {%- if st.button != blank or st.button2 != blank -%}
      <div class="iph__actions">
        {%- if st.button != blank -%}<a class="btn btn--money" href="{{ st.link | default: '/products/everyday' }}">{{ st.button }}</a>{%- endif -%}
        {%- if st.button2 != blank -%}<a class="btn btn--ghost" href="{{ st.link2 | default: '/pages/help' }}">{{ st.button2 }}</a>{%- endif -%}
      </div>
      {%- endif -%}
    </div>
    {%- if photo != blank -%}
      <figure class="iph__img">{{ photo | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 44vw, 100vw', alt: st.alt | default: photo.alt }}</figure>
    {%- elsif asset_src != '' -%}
      <figure class="iph__img iph__img--cut"><img src="{{ asset_src }}" alt="{{ st.alt | escape }}" width="1000" height="1000" loading="eager" fetchpriority="high"></figure>
    {%- endif -%}
  </div>
  {%- if links.size > 0 -%}
  <nav class="iph__jump" aria-label="{{ st.jump_label | default: 'On this page' }}">
    <div class="wrap"><span class="iph__jump-h">{{ st.jump_label | default: 'On this page' }}</span><ul role="list">
      {%- for b in links -%}<li {{ b.shopify_attributes }}><a href="{{ b.settings.url }}">{{ b.settings.label }}</a></li>{%- endfor -%}
    </ul></div>
  </nav>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "select", "id": "tone", "label": "Background", "default": "paper", "options": [
      { "value": "paper", "label": "Paper" }, { "value": "wash", "label": "Teal wash" }, { "value": "ink", "label": "Ink" }, { "value": "sun", "label": "Sun (orange)" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading (blank uses the page title)" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent" },
    { "type": "richtext", "id": "text", "label": "Text", "info": "Blank uses the page's own content." },
    { "type": "text", "id": "button", "label": "Button" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "text", "id": "button2", "label": "Second button" },
    { "type": "url", "id": "link2", "label": "Second button link" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "image_file", "label": "Photo file name in Files (used when Photo is blank)" },
    { "type": "text", "id": "asset", "label": "Theme cutout file (used when both are blank)" },
    { "type": "text", "id": "alt", "label": "Photo description" },
    { "type": "text", "id": "jump_label", "label": "Jump links label", "default": "On this page" }
  ],
  "blocks": [
    { "type": "chip", "name": "Stat chip", "limit": 3, "settings": [
      { "type": "text", "id": "value", "label": "Value", "default": "0g" },
      { "type": "text", "id": "label", "label": "Label", "default": "sugar" }
    ] },
    { "type": "link", "name": "Jump link", "settings": [
      { "type": "text", "id": "label", "label": "Label", "default": "Section" },
      { "type": "text", "id": "url", "label": "Link (#anchor or URL)", "default": "#" }
    ] }
  ],
  "presets": [ { "name": "Page hero" } ]
}
{% endschema %}
