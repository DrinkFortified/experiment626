    "faq": {
      "type": "ff-faq",
      "blocks": {
        "q0": {
          "type": "qa",
          "settings": {
            "q": "What is the difference between Energy and Everyday?",
            "a": "<p>Both share the same electrolyte base and 1,200mg sodium. Energy adds 150mg natural caffeine from coffee bean. Everyday is caffeine-free and adds Vitamin D3 and Vitamin K2.</p>"
          }
        },
        "q1": {
          "type": "qa",
          "settings": {
            "q": "What is it sweetened with?",
            "a": "<p>Monk fruit extract and Reb M (as OnoSweet). 0g sugar per stick pack.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "q": "How does Every 3 months work?",
            "a": "<p>We ship a 90 day supply in one box every 3 months at 20% off. Skip, swap organic flavors or cancel in your account anytime.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "How do I skip or cancel?",
            "a": "<p>Log in to your account and open your subscription. Skip, swap, change quantity or cancel before your next billing date.</p>"
          }
        }
      },
