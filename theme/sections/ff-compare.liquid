{%- comment -%}
  Side by side: Everyday, Energy and Creatine. Pouches and prices come from the products; each
  row block is one line of the comparison.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign p1 = all_products[st.handle_1]
  assign p2 = all_products[st.handle_2]
  assign p3 = all_products[st.handle_3]
-%}
<section class="sec sec--paper2 cmpt" id="{{ st.anchor | default: 'compare' }}" aria-labelledby="cmpt-h-{{ section.id }}">
  <div class="wrap">
    <h2 id="cmpt-h-{{ section.id }}" class="display d2">{{ st.heading }} <em>{{ st.heading_accent }}</em></h2>
    {%- if st.text != blank -%}<p class="lede">{{ st.text }}</p>{%- endif -%}
    <div class="cmpt__scroll" tabindex="0" role="region" aria-label="{{ st.heading | escape }} {{ st.heading_accent | escape }}">
      <table class="cmpt__table">
        <thead>
          <tr>
            <td></td>
            {%- for i in (1..3) -%}
              {%- case i -%}
                {%- when 1 -%}{%- assign pp = p1 -%}{%- assign lb = st.label_1 -%}{%- assign im = st.asset_1 -%}{%- assign tone = 'everyday' -%}
                {%- when 2 -%}{%- assign pp = p2 -%}{%- assign lb = st.label_2 -%}{%- assign im = st.asset_2 -%}{%- assign tone = 'energy' -%}
                {%- when 3 -%}{%- assign pp = p3 -%}{%- assign lb = st.label_3 -%}{%- assign im = st.asset_3 -%}{%- assign tone = 'creatine' -%}
              {%- endcase -%}
              <th scope="col" class="cmpt__col cmpt__col--{{ tone }}">
                <a href="{{ pp.url | default: '#' }}" class="cmpt__prod">
                  {%- if im != blank -%}<img src="{{ im | asset_url }}" alt="" width="400" height="400" loading="lazy">{%- endif -%}
                  <span class="cmpt__name">{{ lb }}</span>
                  {%- if pp != blank -%}<span class="cmpt__price num">{{ pp.price | money_without_trailing_zeros }}</span>{%- endif -%}
                </a>
              </th>
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for b in section.blocks -%}
          <tr {{ b.shopify_attributes }}>
            <th scope="row">{{ b.settings.label }}</th>
            {%- assign cells = b.settings.v1 | append: '||' | append: b.settings.v2 | append: '||' | append: b.settings.v3 | split: '||' -%}
            {%- for c in cells -%}
              {%- assign cv = c | strip -%}
              <td>{%- if cv == 'yes' -%}<svg class="cmpt__yes" viewBox="0 0 24 24" role="img" aria-label="Yes"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>{%- elsif cv == 'no' or cv == '' -%}<span class="cmpt__no" aria-label="No">&ndash;</span>{%- else -%}{{ cv }}{%- endif -%}</td>
            {%- endfor -%}
          </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if st.note != blank -%}<p class="ing__note">{{ st.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Formula comparison",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three formulas," },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "side by side." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "handle_1", "label": "Column 1 product handle", "default": "everyday" },
    { "type": "text", "id": "label_1", "label": "Column 1 label", "default": "Everyday" },
    { "type": "text", "id": "asset_1", "label": "Column 1 image (theme file)", "default": "ff-everyday-watermelon-front.webp" },
    { "type": "text", "id": "handle_2", "label": "Column 2 product handle", "default": "energy" },
    { "type": "text", "id": "label_2", "label": "Column 2 label", "default": "Energy" },
    { "type": "text", "id": "asset_2", "label": "Column 2 image (theme file)", "default": "ff-energy-orange-front.webp" },
    { "type": "text", "id": "handle_3", "label": "Column 3 product handle", "default": "creatine-v2" },
    { "type": "text", "id": "label_3", "label": "Column 3 label", "default": "Creatine" },
    { "type": "text", "id": "asset_3", "label": "Column 3 image (theme file)", "default": "ff-creatine-cutout.webp" },
    { "type": "text", "id": "note", "label": "Small note" }
  ],
  "blocks": [ { "type": "row", "name": "Row", "settings": [
    { "type": "text", "id": "label", "label": "Row label", "default": "Sodium" },
    { "type": "text", "id": "v1", "label": "Column 1 (yes, no or text)", "default": "1,200mg" },
    { "type": "text", "id": "v2", "label": "Column 2 (yes, no or text)", "default": "1,200mg" },
    { "type": "text", "id": "v3", "label": "Column 3 (yes, no or text)", "default": "no" }
  ] } ],
  "presets": [ { "name": "Formula comparison" } ]
}
{% endschema %}
