{%- comment -%}
  Creatine product page that doubles as a landing page: the pouch (front and back),
  the one-ingredient story, a one-time buy box, and the free-with-subscription offer.
  Sold one-time here; subscribers get it free with 3 or more subscription packs.
{%- endcomment -%}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign front = section.settings.front_image
  if front == blank
    assign front = images['Creatine_PDP_01.webp']
  endif
  if front == blank
    assign front = product.featured_image
  endif
  assign back = section.settings.back_image
  if back == blank
    assign back = images['Creatine_PDP_Back.webp']
  endif
-%}
<section class="cr-hero" aria-labelledby="cr-h-{{ section.id }}">
  <div class="cr-hero__bg" aria-hidden="true"></div>
  <div class="wrap cr-grid">
    <div class="cr-stage" data-cr-stage>
      <div class="cr-big" aria-hidden="true">{{ section.settings.big }}<span>{{ section.settings.big_unit }}</span></div>
      <div class="cr-flip" data-cr-flip>
        <div class="cr-face cr-face--front">{%- if front != blank -%}<span class="hz-crop">{{ front | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: 'Fortified Creatine Monohydrate pouch, front' }}</span>{%- endif -%}</div>
        {%- if back != blank -%}<div class="cr-face cr-face--back"><span class="hz-crop cr-crop-back">{{ back | image_url: width: 1400 | image_tag: loading: 'lazy', alt: 'Fortified Creatine Monohydrate pouch, back with the label' }}</span></div>{%- endif -%}
      </div>
      {%- if back != blank -%}
      <button type="button" class="hz-turn cr-turn" data-cr-turn aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12a8 8 0 0 1 13.7-5.6M20 4v5h-5M20 12a8 8 0 0 1-13.7 5.6M4 20v-5h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span data-cr-turn-label>Read the back</span>
      </button>
      {%- endif -%}
    </div>

    <div class="cr-buy">
      <p class="hz-kicker">{{ section.settings.kicker }}</p>
      <h1 id="cr-h-{{ section.id }}" class="display cr-h">{{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em></h1>
      <p class="lede">{{ section.settings.text }}</p>
      <ul class="cr-facts">
        {%- for i in (1..3) -%}
          {%- capture k -%}fact_{{ i }}_k{%- endcapture -%}{%- capture val -%}fact_{{ i }}_v{%- endcapture -%}
          {%- if section.settings[val] != blank -%}<li><b>{{ section.settings[val] }}</b><small>{{ section.settings[k] }}</small></li>{%- endif -%}
        {%- endfor -%}
      </ul>

      <div class="cr-box">
        <div class="cr-box__row">
          <div><b class="cr-box__title">One-time</b><small>One pouch, {{ section.settings.servings }} servings. No subscription.</small></div>
          <span class="cr-box__price num" data-cr-price>{{ v.price | money }}</span>
        </div>
        <div class="cr-box__row cr-box__row--qty">
          <div class="stepper stepper--sm" data-cr-qty>
            <button type="button" data-step="-1" aria-label="One fewer pouch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/></svg></button>
            <label class="sr" for="cr-q-{{ section.id }}">Pouches</label>
            <input id="cr-q-{{ section.id }}" class="num" type="number" inputmode="numeric" min="1" max="12" value="1">
            <button type="button" data-step="1" aria-label="One more pouch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button>
          </div>
          <button type="button" class="btn btn--money cr-add" data-cr-add data-variant="{{ v.id }}" data-price="{{ v.price }}"{% unless v.available %} disabled{% endunless %}>{% if v.available %}Add to box{% else %}Sold out{% endif %}</button>
        </div>
        <p class="pd__error" data-cr-error role="alert" hidden></p>
      </div>

      {%- if section.settings.offer_text != blank -%}
      <a class="cr-offer" href="{{ section.settings.offer_link | default: '/products/everyday' }}">
        <span class="cr-offer__badge">Free</span>
        <span class="cr-offer__txt"><b>{{ section.settings.offer_title }}</b><small>{{ section.settings.offer_text }}</small></span>
        <span class="cr-offer__go" aria-hidden="true">&rarr;</span>
      </a>
      {%- endif -%}
      {%- if section.settings.disclaimer != blank -%}<p class="pd__fine">{{ section.settings.disclaimer }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Creatine hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Creatine Monohydrate · Pure Unflavored" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One ingredient." },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "Nothing else in the pouch." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Pure creatine monohydrate. 5 grams per serving, with no flavors, no sweeteners and no fillers. One ingredient on the label because one ingredient is all that's in it." },
    { "type": "text", "id": "fact_1_v", "label": "Fact 1 value", "default": "5g" },
    { "type": "text", "id": "fact_1_k", "label": "Fact 1 label", "default": "per serving" },
    { "type": "text", "id": "fact_2_v", "label": "Fact 2 value", "default": "45" },
    { "type": "text", "id": "fact_2_k", "label": "Fact 2 label", "default": "servings" },
    { "type": "text", "id": "fact_3_v", "label": "Fact 3 value", "default": "1" },
    { "type": "text", "id": "fact_3_k", "label": "Fact 3 label", "default": "ingredient" },
    { "type": "text", "id": "servings", "label": "Servings per pouch", "default": "45" },
    { "type": "text", "id": "big", "label": "Large outlined figure", "default": "5" },
    { "type": "text", "id": "big_unit", "label": "Large figure unit", "default": "g" },
    { "type": "image_picker", "id": "front_image", "label": "Front image (blank uses Creatine_PDP_01.webp)" },
    { "type": "image_picker", "id": "back_image", "label": "Back image (blank uses Creatine_PDP_Back.webp)" },
    { "type": "text", "id": "offer_title", "label": "Offer title", "default": "Free Creatine For Life of Subscription" },
    { "type": "text", "id": "offer_text", "label": "Offer text", "default": "Subscribe to 3 or more packs of Everyday or Energy and a pouch ships free with every delivery." },
    { "type": "url", "id": "offer_link", "label": "Offer link" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease." }
  ]
}
{% endschema %}
