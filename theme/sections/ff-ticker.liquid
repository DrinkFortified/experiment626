{%- capture row -%}{%- for block in section.blocks -%}<span {{ block.shopify_attributes }}>{{ block.settings.text }} <i>/</i></span>{%- endfor -%}{%- endcapture -%}
<div class="ticker" aria-label="{{ section.blocks | map: 'settings' | map: 'text' | join: ', ' | escape }}"><div class="ticker__track" aria-hidden="true">{{ row }}{{ row }}</div></div>

{% schema %}
{
  "name": "Claims ticker",
  "max_blocks": 12,
  "blocks": [ { "type": "claim", "name": "Claim", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "0g sugar" } ] } ],
  "presets": [ { "name": "Claims ticker", "blocks": [
    { "type": "claim", "settings": { "text": "0g sugar" } }, { "type": "claim", "settings": { "text": "No dyes" } },
    { "type": "claim", "settings": { "text": "Every ingredient named" } }, { "type": "claim", "settings": { "text": "Organic flavors" } },
    { "type": "claim", "settings": { "text": "Monk fruit sweetened" } }, { "type": "claim", "settings": { "text": "1,200mg sodium" } } ] } ]
}
{% endschema %}
