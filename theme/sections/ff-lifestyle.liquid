{%- comment -%}
  Lifestyle band: one large photo with a short caption card. The photo drifts with
  the scroll and the caption slides in. Photo comes from the picker, else from Files.
{%- endcomment -%}
{%- liquid
  assign img = section.settings.image
  if img == blank and section.settings.file_name != blank
    assign img = images[section.settings.file_name]
  endif
-%}
{%- if img != blank -%}
<section class="lfs lfs--{{ section.settings.align }}" data-sp data-crf aria-labelledby="lfs-h-{{ section.id }}">
  <div class="lfs__photo">
    <img src="{{ img | image_url: width: 2000 }}" srcset="{{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1400 }} 1400w, {{ img | image_url: width: 2000 }} 2000w" sizes="(min-width: 861px) 62vw, 100vw" alt="{{ section.settings.alt | default: img.alt | escape }}" width="{{ img.width | default: 1840 }}" height="{{ img.height | default: 2000 }}" loading="lazy">
  </div>
  <div class="lfs__card">
    {%- if section.settings.kicker != blank -%}<p class="lfs__kicker">{{ section.settings.kicker }}</p>{%- endif -%}
    <h2 id="lfs-h-{{ section.id }}" class="crf__h lfs__h">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="lfs__text">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button != blank -%}<a class="btn btn--money" href="{{ section.settings.link | default: '/products/everyday' }}">{{ section.settings.button }}</a>{%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Lifestyle photo band",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "file_name", "label": "Photo file name in Files (used when Photo is blank)", "default": "ff-lifestyle-sandals-v3.png" },
    { "type": "text", "id": "alt", "label": "Photo description" },
    { "type": "select", "id": "align", "label": "Photo side", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Everyday · Salty Orange" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pack it. Pour it. Enjoy the afternoon." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Toss a few sticks in the bag. One stick in cold water when you need it, caffeine-free, with a flavor the whole family reaches for." },
    { "type": "text", "id": "button", "label": "Button", "default": "Shop Everyday" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [ { "name": "Lifestyle photo band" } ]
}
{% endschema %}
