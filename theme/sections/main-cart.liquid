<section class="sec" style="padding-top:clamp(48px,6vw,96px)">
  <div class="wrap" style="max-width:820px">
    <h1 class="display d2">{{ 'cart.title' | t }}</h1>
    {%- if cart.item_count == 0 -%}
      <p class="lede">{{ 'cart.empty' | t }}</p>
      <p style="margin-top:24px"><a class="btn btn--money" href="/products/everyday">Shop Everyday</a></p>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        {%- for item in cart.items -%}
          <div class="cart-line">
            <div class="pack">{%- if item.image -%}{{ item.image | image_url: width: 160 | image_tag: alt: item.title }}{%- endif -%}</div>
            <div><b>{{ item.product.title | split: ' by ' | first }}</b><small>{% unless item.variant.title contains 'Organic' %}Organic {% endunless %}{{ item.variant.title }}{% if item.selling_plan_allocation %} · {{ item.selling_plan_allocation.selling_plan.name }}{% endif %}</small><br>
              <label class="sr" for="q-{{ forloop.index }}">Quantity</label>
              <input id="q-{{ forloop.index }}" class="num" type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:72px;height:40px;margin-top:6px">
            </div>
            <div class="cart-line__price">{%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}{{ item.final_line_price | money }}</div>
          </div>
        {%- endfor -%}
        <div class="total-row total-row--big" style="margin-top:20px"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
        <p class="legal">{{ 'cart.taxes' | t }}</p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px">
          <button class="btn btn--ghost" type="submit" name="update">Update</button>
          <button class="btn btn--money" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
