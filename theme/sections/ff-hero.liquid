{%- comment -%}
  Hero, two slides that rotate.
  Slide 1 (studio): the two real pouches large, as 3D objects in a soft glow of the
  pack colours, with spec callouts that draw out from the pouch. Drag a pouch, or
  use the button, to turn them over and read the back.
  Slide 2 (navy): subscribe to 3 packs, get Free Creatine For Life of Subscription.
  A faint 3+1 behind three fanned pouches and the creatine, with a turning ring badge.
  Reduced motion: everything rests; turning still works.
{%- endcomment -%}
{%- liquid
  assign show_offer = section.settings.offer_enabled
  assign p_every = section.settings.product_everyday
  if p_every == blank
    assign p_every = all_products['everyday']
  endif
  assign p_energy = section.settings.product_energy
  if p_energy == blank
    assign p_energy = all_products['energy']
  endif
  assign cre_img = section.settings.offer_creatine_image
-%}
<section class="p-hero hz{% if show_offer %} p-hero--rotate{% endif %}" aria-labelledby="hero-{{ section.id }}"
  {%- if show_offer %} data-hero-rotate="{{ section.settings.interval | default: 8 }}" aria-roledescription="carousel" aria-label="Highlights"{% endif %}>
  <div class="p-hero__slides">

    <div class="p-hero__slide hz-slide is-active" data-hero-slide{% if show_offer %} role="group" aria-roledescription="slide" aria-label="1 of 2"{% endif %}>
      <div class="hz-bg" aria-hidden="true"></div>
      <div class="wrap hz-grid">
        <div class="hz-copy">
          {%- if section.settings.kicker != blank -%}<p class="hz-kicker hz-in" style="--i:0">{{ section.settings.kicker }}</p>{%- endif -%}
          <h1 id="hero-{{ section.id }}" class="display hz-h"><span class="hz-mask"><span class="hz-line">{{ section.settings.heading }}</span></span> <span class="hz-mask"><em class="hz-line" style="--d:.12s">{{ section.settings.heading_accent }}</em></span></h1>
          <p class="lede hz-lede hz-in" style="--i:3">{{ section.settings.text }}</p>
          <div class="p-hero__actions hz-in" style="--i:4">
            {%- if section.settings.button_1 != blank -%}<a class="btn btn--money" href="{{ section.settings.link_1 | default: '/products/everyday' }}">{{ section.settings.button_1 }}</a>{%- endif -%}
            {%- if section.settings.button_2 != blank -%}<a class="btn btn--ghost" href="{{ section.settings.link_2 | default: '/products/energy' }}">{{ section.settings.button_2 }}</a>{%- endif -%}
          </div>
          {%- if section.settings.note != blank -%}<p class="p-hero__note hz-in" style="--i:5">{{ section.settings.note }}</p>{%- endif -%}
        </div>

        {%- if section.settings.photo != blank -%}
          <figure class="hz-photo">{{ section.settings.photo | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 55vw, 100vw' }}</figure>
        {%- else -%}
        <div class="hz-stage" data-hx-stage>
          <div class="hz-glow" aria-hidden="true"></div>
          <div class="hz-scene" data-hx-scene>
            {%- if p_energy -%}
            <div class="hz-pack hz-pack--a" data-hx-pack>
              <div class="hz-rise"><div class="hz-float"><div class="hz-spin" data-hx-spin>{%- render 'ff-bag3d', product: p_energy, flavor: 'orange', width: 1100, loading: 'eager' -%}</div></div></div>
            </div>
            {%- endif -%}
            {%- if p_every -%}
            <div class="hz-pack hz-pack--b" data-hx-pack>
              <div class="hz-rise"><div class="hz-float"><div class="hz-spin" data-hx-spin>{%- render 'ff-bag3d', product: p_every, flavor: 'watermelon', width: 1100, loading: 'eager' -%}</div></div></div>
            </div>
            {%- endif -%}
          </div>
          <ul class="hz-notes" aria-label="On the label">
            {%- if section.settings.note_1_v != blank -%}<li class="hz-note hz-note--1" style="--n:0"><i class="hz-note__line" aria-hidden="true"></i><span class="hz-note__txt"><small>{{ section.settings.note_1_k }}</small><b>{{ section.settings.note_1_v }}</b></span></li>{%- endif -%}
            {%- if section.settings.note_2_v != blank -%}<li class="hz-note hz-note--2" style="--n:1"><i class="hz-note__line" aria-hidden="true"></i><span class="hz-note__txt"><small>{{ section.settings.note_2_k }}</small><b>{{ section.settings.note_2_v }}</b></span></li>{%- endif -%}
            {%- if section.settings.note_3_v != blank -%}<li class="hz-note hz-note--3" style="--n:2"><i class="hz-note__line" aria-hidden="true"></i><span class="hz-note__txt"><small>{{ section.settings.note_3_k }}</small><b>{{ section.settings.note_3_v }}</b></span></li>{%- endif -%}
          </ul>
          <button type="button" class="hz-turn" data-hx-turn aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12a8 8 0 0 1 13.7-5.6M20 4v5h-5M20 12a8 8 0 0 1-13.7 5.6M4 20v-5h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span data-hx-turn-label>Turn it over</span><span class="hz-turn__hint" aria-hidden="true">or drag the pouch</span>
          </button>
        </div>
        {%- endif -%}
      </div>
    </div>

    {%- if show_offer -%}
    <div class="p-hero__slide hz-slide hz-slide--dark" data-hero-slide role="group" aria-roledescription="slide" aria-label="2 of 2" aria-hidden="true" inert>
      <div class="hz-bg hz-bg--dark" aria-hidden="true"></div>
      <div class="wrap hz-grid">
        <div class="hz-copy">
          {%- if section.settings.offer_eyebrow != blank -%}<p class="hz-kicker hz-in" style="--i:0">{{ section.settings.offer_eyebrow }}</p>{%- endif -%}
          <h2 class="display hz-h hz-h--offer"><span class="hz-mask"><span class="hz-line">{{ section.settings.offer_heading }}</span></span> <span class="hz-mask"><em class="hz-line" style="--d:.12s">{{ section.settings.offer_heading_accent }}</em></span></h2>
          <p class="lede hz-lede hz-in" style="--i:3">{{ section.settings.offer_text }}</p>
          <div class="p-hero__actions hz-in" style="--i:4">
            {%- if section.settings.offer_button_1 != blank -%}<a class="btn btn--money" href="{{ section.settings.offer_link_1 | default: '/products/everyday' }}" tabindex="-1">{{ section.settings.offer_button_1 }}</a>{%- endif -%}
            {%- if section.settings.offer_button_2 != blank -%}<a class="btn btn--ghost hz-btn-light" href="{{ section.settings.offer_link_2 | default: '/products/energy' }}" tabindex="-1">{{ section.settings.offer_button_2 }}</a>{%- endif -%}
          </div>
          {%- if section.settings.offer_note != blank -%}<p class="p-hero__note hz-in" style="--i:5">{{ section.settings.offer_note }}</p>{%- endif -%}
        </div>
        <div class="hz-stage hz-stage--offer">
          <div class="hz-big" aria-hidden="true">3<span>+</span>1</div>
          <div class="hz-offer">
            <div class="hz-trio">
              {%- if p_every -%}<div class="hz-opack" style="--k:0"><div class="hz-rise"><div class="hz-float">{%- render 'ff-bag3d', product: p_every, flavor: 'watermelon', width: 800 -%}</div></div></div>{%- endif -%}
              {%- if p_energy -%}<div class="hz-opack" style="--k:1"><div class="hz-rise"><div class="hz-float">{%- render 'ff-bag3d', product: p_energy, flavor: 'orange', width: 800 -%}</div></div></div>{%- endif -%}
              {%- if p_every -%}<div class="hz-opack" style="--k:2"><div class="hz-rise"><div class="hz-float">{%- render 'ff-bag3d', product: p_every, flavor: 'orange', width: 800 -%}</div></div></div>{%- endif -%}
            </div>
            <div class="hz-gift">
              <div class="hz-rise"><div class="hz-float">
                {%- if cre_img != blank -%}
                  {{ cre_img | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Fortified Creatine Monohydrate pouch' }}
                {%- else -%}
                  {%- assign cre_file = images['Creatine_PDP_01.webp'] -%}
                  {%- if cre_file -%}<span class="hz-crop">{{ cre_file | image_url: width: 1400 | image_tag: loading: 'lazy', alt: 'Fortified Creatine Monohydrate pouch' }}</span>{%- endif -%}
                {%- endif -%}
              </div></div>
              <div class="hz-ring" aria-hidden="true">
                <svg class="hz-ring__text" viewBox="0 0 120 120" focusable="false"><defs><path id="hzc-{{ section.id }}" d="M60,60 m-47,0 a47,47 0 1,1 94,0 a47,47 0 1,1 -94,0"/></defs><text><textPath href="#hzc-{{ section.id }}" textLength="292" lengthAdjust="spacing">FREE CREATINE FOR LIFE OF SUBSCRIPTION &#8226;</textPath></text></svg>
                <span class="hz-ring__core">Free</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    {%- endif -%}
  </div>

  {%- if show_offer -%}
  <div class="p-hero__dots hz-dots" role="group" aria-label="Choose a slide">
    <button type="button" class="p-hero__dot" data-hero-dot="0" aria-label="Show slide 1" aria-current="true"><i></i></button>
    <button type="button" class="p-hero__dot" data-hero-dot="1" aria-label="Show slide 2: {{ section.settings.offer_heading_accent | escape }}"><i></i></button>
    <button type="button" class="p-hero__pause" data-hero-pause aria-label="Pause rotation" aria-pressed="false">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="i-pause"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/></svg>
      <svg viewBox="0 0 24 24" aria-hidden="true" class="i-play"><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg>
    </button>
  </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "header", "content": "Slide 1" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Electrolyte drink mix · Everyday and Energy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Electrolytes with" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "nothing to hide." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A short list of ingredients you can name, sweetened with monk fruit, for the mom who turns the pack over before it reaches her family." },
    { "type": "text", "id": "button_1", "label": "Button 1", "default": "Shop Everyday" },
    { "type": "url", "id": "link_1", "label": "Button 1 link" },
    { "type": "text", "id": "button_2", "label": "Button 2", "default": "Shop Energy" },
    { "type": "url", "id": "link_2", "label": "Button 2 link" },
    { "type": "text", "id": "note", "label": "Note", "default": "Save 20% every 3 months. Skip or cancel online." },
    { "type": "product", "id": "product_everyday", "label": "Everyday product (blank: everyday)" },
    { "type": "product", "id": "product_energy", "label": "Energy product (blank: energy)" },
    { "type": "image_picker", "id": "photo", "label": "Lifestyle photo (replaces the 3D pouches)" },
    { "type": "text", "id": "note_1_k", "label": "Callout 1 label", "default": "Sodium" },
    { "type": "text", "id": "note_1_v", "label": "Callout 1 value", "default": "1,200mg" },
    { "type": "text", "id": "note_2_k", "label": "Callout 2 label", "default": "Sugar" },
    { "type": "text", "id": "note_2_v", "label": "Callout 2 value", "default": "0g" },
    { "type": "text", "id": "note_3_k", "label": "Callout 3 label", "default": "Sweetened with" },
    { "type": "text", "id": "note_3_v", "label": "Callout 3 value", "default": "Monk fruit" },
    { "type": "header", "content": "Slide 2: subscription offer" },
    { "type": "checkbox", "id": "offer_enabled", "label": "Show and rotate the offer slide", "default": true },
    { "type": "range", "id": "interval", "label": "Seconds per slide", "min": 4, "max": 15, "step": 1, "unit": "s", "default": 8 },
    { "type": "text", "id": "offer_eyebrow", "label": "Kicker", "default": "Subscription offer" },
    { "type": "text", "id": "offer_heading", "label": "Heading", "default": "Subscribe to 3 packs, get" },
    { "type": "text", "id": "offer_heading_accent", "label": "Heading accent", "default": "Free Creatine For Life of Subscription." },
    { "type": "textarea", "id": "offer_text", "label": "Text", "default": "Mix Everyday and Energy in any organic flavor, Monthly or Every 3 months. A pouch of pure creatine monohydrate comes free with every delivery for as long as you stay subscribed." },
    { "type": "text", "id": "offer_button_1", "label": "Button 1", "default": "Build your 3" },
    { "type": "url", "id": "offer_link_1", "label": "Button 1 link" },
    { "type": "text", "id": "offer_button_2", "label": "Button 2", "default": "Shop Energy" },
    { "type": "url", "id": "offer_link_2", "label": "Button 2 link" },
    { "type": "text", "id": "offer_note", "label": "Note", "default": "Added to your box automatically at 3 subscription packs. Skip or cancel online anytime." },
    { "type": "image_picker", "id": "offer_creatine_image", "label": "Creatine image (blank uses Creatine_PDP_01.webp from Files)" }
  ],
  "presets": [ { "name": "Fortified hero" } ]
}
{% endschema %}
