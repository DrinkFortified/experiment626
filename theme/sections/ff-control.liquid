<section class="sec on-dark" aria-labelledby="ctrl-h">
  <div class="wrap control-grid">
    <div>
      <h2 id="ctrl-h" class="display d2">{{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em></h2>
      <p class="lede">{{ section.settings.text }}</p>
    </div>
    <div class="ui" data-sub-ui aria-label="Example of the subscription screen">
      <div class="ui__top">My Subscriptions <span>Next order in 3 months</span></div>
      <div class="ui__row"><div class="pack"><img src="{{ 'ff-everyday-watermelon-front.webp' | asset_url }}" alt="" loading="lazy" width="885" height="900"></div><div><b>Everyday</b><small>Salty Watermelon</small></div><span class="num">2 packs</span></div>
      <div class="ui__row"><div class="pack"><img src="{{ 'ff-energy-orange-front.webp' | asset_url }}" alt="" loading="lazy" width="885" height="900"></div><div><b>Energy</b><small>Salty Orange</small></div><span class="num">1 pack</span></div>
      <div class="ui__acts"><button type="button" data-act="skip">Skip</button><button type="button" data-act="swap">Swap</button><button type="button" data-act="pause">Pause</button><button type="button" data-act="gift">Gift</button></div>
      <div class="ui__toast" data-ui-toast aria-live="polite">Try it. Tap any action.</div>
      <p class="ui__fine">Cancel at any time.</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Subscription control",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You stay in charge" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "of every order." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Skip, swap flavors, pause, or send the next box as a gift, all in your account. We email you before every renewal." }
  ],
  "presets": [ { "name": "Subscription control" } ]
}
{% endschema %}
