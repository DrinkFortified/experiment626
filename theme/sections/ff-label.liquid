<section class="sec sec--paper2" aria-labelledby="label-h" data-hl-section>
  <div class="wrap p-label">
    <div>
      <h2 id="label-h" class="display d2">{{ section.settings.heading }} <em>{{ section.settings.heading_accent }}</em></h2>
      <p class="lede">{{ section.settings.text }}</p>
      <dl class="numbers">
        <div class="hl-row" data-hl><dt>Sodium</dt><dd class="num">{{ section.settings.sodium }}</dd></div>
        <div class="hl-row" data-hl><dt>Potassium</dt><dd class="num">{{ section.settings.potassium }}</dd></div>
        <div class="hl-row" data-hl><dt>Magnesium</dt><dd class="num">{{ section.settings.magnesium }}</dd></div>
        <div class="hl-row" data-hl><dt>Sugar</dt><dd class="num">{{ section.settings.sugar }}</dd></div>
      </dl>
      <ul class="p-never" aria-label="Never in our packs">
        <li class="hl-row" data-hl><span>Proprietary blends</span><span>never</span></li>
        <li class="hl-row" data-hl><span>Synthetic dyes</span><span>never</span></li>
        <li class="hl-row" data-hl><span>Fillers you can&rsquo;t pronounce</span><span>never</span></li>
      </ul>
      {%- if section.settings.show_back -%}
      <figure class="backpack">
        {%- if section.settings.back_image != blank -%}{{ section.settings.back_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'Back of the pouch with the Nutrition Facts panel' }}{%- else -%}<img src="{{ 'ff-everyday-orange-back.webp' | asset_url }}" alt="Back of the pouch with the Nutrition Facts panel" loading="lazy" width="900" height="796">{%- endif -%}
        <figcaption class="p-handnote">Read the back first.</figcaption>
      </figure>
      {%- endif -%}
    </div>
    <div class="sheet-wrap"><div class="sheet">
      <div class="sheet__head"><div class="sheet__title">{{ section.settings.list_title }}</div><div class="sheet__meta">{{ section.settings.list_meta }}</div></div>
      <ul class="items">
        {%- for block in section.blocks -%}
          {%- liquid
            assign fn = block.settings.function | default: 'none'
            if fn == 'none' and block.settings.added
              if block.settings.name contains 'Energy'
                assign fn = 'energy'
              elsif block.settings.name contains 'Everyday'
                assign fn = 'everyday'
              endif
            endif
          -%}
          <li class="item hl-row{% if block.settings.added %} item--add{% endif %}{% if fn != 'none' %} hl-fn hl-fn--{{ fn }}{% endif %}" data-hl {{ block.shopify_attributes }}><span class="item__name">{{ block.settings.name }}</span><span class="item__lead"></span><span class="item__val">{{ block.settings.source }}</span></li>
        {%- endfor -%}
      </ul>
    </div></div>
  </div>
</section>

{% schema %}
{
  "name": "The label",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The whole label," },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "read in a minute." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Both formulas share one short electrolyte base. This is every ingredient, in the order printed on the pack." },
    { "type": "text", "id": "sodium", "label": "Sodium", "default": "1,200mg" },
    { "type": "text", "id": "potassium", "label": "Potassium", "default": "200mg" },
    { "type": "text", "id": "magnesium", "label": "Magnesium", "default": "150mg" },
    { "type": "text", "id": "sugar", "label": "Sugar", "default": "0g" },
    { "type": "checkbox", "id": "show_back", "label": "Show the back of pack image", "info": "Turn off when the 3D pouch turn section is on the page.", "default": true },
    { "type": "image_picker", "id": "back_image", "label": "Back of pack image" },
    { "type": "text", "id": "list_title", "label": "List title", "default": "The shared base" },
    { "type": "text", "id": "list_meta", "label": "List note", "default": "In both Energy and Everyday" }
  ],
  "blocks": [ { "type": "ingredient", "name": "Ingredient", "settings": [
    { "type": "text", "id": "name", "label": "Ingredient", "default": "Pink Himalayan Salt" },
    { "type": "text", "id": "source", "label": "Source or role", "default": "as Ancient Ocean" },
    { "type": "checkbox", "id": "added", "label": "Formula-specific (adds a plus)", "default": false },
    { "type": "select", "id": "function", "label": "Function color", "default": "none", "info": "Highlights the row in that formula's color.", "options": [ { "value": "none", "label": "None (shared base)" }, { "value": "everyday", "label": "Everyday" }, { "value": "energy", "label": "Energy" } ] } ] } ],
  "presets": [ { "name": "The label", "blocks": [
    { "type": "ingredient", "settings": { "name": "Pink Himalayan Salt", "source": "as Ancient Ocean" } },
    { "type": "ingredient", "settings": { "name": "Magnesium Malate", "source": "magnesium" } },
    { "type": "ingredient", "settings": { "name": "Coconut Water Powder", "source": "as CocOganic Plus" } },
    { "type": "ingredient", "settings": { "name": "Organic Lemon Juice Powder", "source": "flavor" } },
    { "type": "ingredient", "settings": { "name": "Potassium Chloride", "source": "potassium" } },
    { "type": "ingredient", "settings": { "name": "Bamboo Fiber", "source": "fiber" } },
    { "type": "ingredient", "settings": { "name": "Organic Flavors", "source": "flavor" } },
    { "type": "ingredient", "settings": { "name": "Malic Acid", "source": "tartness" } },
    { "type": "ingredient", "settings": { "name": "Reb M, fermented", "source": "as OnoSweet" } },
    { "type": "ingredient", "settings": { "name": "Monk Fruit Extract", "source": "sweetener" } },
    { "type": "ingredient", "settings": { "name": "Energy adds Natural Caffeine", "source": "coffee bean, 150mg", "added": true } },
    { "type": "ingredient", "settings": { "name": "Everyday adds Vitamin D3 + K2", "source": "D3 25mcg, K2 as MK-7", "added": true } } ] } ]
}
{% endschema %}
