{%- comment -%}
  JSON for the quick buy shown in an empty cart: Everyday and Energy with their
  flavors, plan prices, and one-time creatine.
{%- endcomment -%}
{%- liquid
  assign handles = 'everyday,energy' | split: ','
  assign cr = all_products['creatine-v2']
-%}
{ "products": [
  {%- for h in handles -%}
    {%- assign p = all_products[h] -%}
    {%- if p.id -%}
      {%- capture pl -%}{%- render 'ff-plan-ids', product: p -%}{%- endcapture -%}
      {%- assign pp = pl | split: '|' -%}
      {%- unless forloop.first -%},{%- endunless -%}
      { "label": {% if h == 'energy' %}"Energy"{% else %}"Everyday"{% endif %}, "monthly": {{ pp[0] | json }}, "quarterly": {{ pp[1] | json }},
        "variants": [
        {%- for v in p.variants -%}
          {%- capture img -%}{%- render 'ff-pouch-image', product: p, variant: v, width: 240 -%}{%- endcapture -%}
          { "id": {{ v.id }}, "title": {{ v.title | json }}, "available": {{ v.available | json }}, "price": {{ v.price }}, "img": {{ img | strip | json }},
            "plans": { {%- for a in v.selling_plan_allocations -%}{{ a.selling_plan.id | append: '' | json }}: {{ a.price }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} } }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
        ] }
    {%- endif -%}
  {%- endfor -%}
  ],
  "creatine": {% if cr.id and cr.first_available_variant %}{ "id": {{ cr.first_available_variant.id }}, "price": {{ cr.first_available_variant.price }}, "url": {{ cr.url | json }}, "img": {{ cr.featured_image | image_url: width: 240 | json }} }{% else %}null{% endif %}
}
