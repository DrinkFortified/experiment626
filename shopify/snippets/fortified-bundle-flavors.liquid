{%- comment -%}
  Outputs a comma-separated list of flavor JSON objects for one product.
  Loop selling plans come from each variant's selling_plan_allocations.
{%- endcomment -%}
{%- if product != blank -%}
  {%- for variant in product.variants -%}
    {%- liquid
      assign flavor = variant.title
      unless flavor contains 'Organic'
        assign flavor = 'Organic ' | append: flavor
      endunless
      assign tagline = 'Clean, salty, and ready for your day.'
      if flavor contains 'Orange'
        assign tagline = 'Bright, citrusy, and ready for your day.'
      elsif flavor contains 'Watermelon'
        assign tagline = 'Bold, refreshing, and ready for your day.'
      endif
      assign img = variant.featured_image | default: product.featured_image
    -%}
    {
      "variantId": {{ variant.id }},
      "flavor": {{ flavor | json }},
      "tagline": {{ tagline | json }},
      "price": {{ variant.price }},
      "image": {% if img %}{{ img | image_url: width: 500 | json }}{% else %}null{% endif %},
      "plans": [
        {%- for alloc in variant.selling_plan_allocations -%}
          {
            "id": {{ alloc.selling_plan.id }},
            "price": {{ alloc.price }},
            "name": {{ alloc.selling_plan.name | json }},
            "days": {{ alloc.selling_plan.options.first.value | default: alloc.selling_plan.name | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
{%- endif -%}
