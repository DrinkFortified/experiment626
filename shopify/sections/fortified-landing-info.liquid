{%- comment -%} Fortified landing: formulas, ingredients, guarantee, FAQ, final CTA. {%- endcomment -%}
{{ 'fortified-landing.css' | asset_url | stylesheet_tag }}
<div class="fl">
  <section class="fl__section fl__section--soft">
    <div class="fl__wrap">
      <div class="fl__center">
        <p class="fl__eyebrow">Choose your formula</p>
        <h2 class="fl__h2">Same clean base. Different job.</h2>
        <p class="fl__lead">Both formulas share one transparent electrolyte base. Pick caffeine for a kick or go caffeine-free for every day.</p>
      </div>
      <div class="fl-compare">
        <article class="fl-formula fl-formula--energy">
          <span class="fl-formula__tag">Caffeine</span>
          <h3>Energy</h3>
          <dl>
            <div><dt>Adds</dt><dd>150mg natural caffeine from coffee bean</dd></div>
            <div><dt>Base</dt><dd>Higher-sodium electrolyte formula</dd></div>
            <div><dt>Flavors</dt><dd>Organic Salty Orange, Organic Salty Watermelon</dd></div>
            <div><dt>Supply</dt><dd>30 day pack</dd></div>
          </dl>
          <div class="fl-formula__foot"><a href="#build" class="fl__btn fl__btn--dark">Add Energy</a><button type="button" class="fl__textlink" data-fb-open="fb-label-energy">View Label</button></div>
        </article>
        <article class="fl-formula fl-formula--everyday">
          <span class="fl-formula__tag">Caffeine-Free</span>
          <h3>Everyday</h3>
          <dl>
            <div><dt>Adds</dt><dd>Vitamin D3 and Vitamin K2 (MK-7)</dd></div>
            <div><dt>Base</dt><dd>Daily electrolyte formula</dd></div>
            <div><dt>Flavors</dt><dd>Organic Salty Orange, Organic Salty Watermelon</dd></div>
            <div><dt>Supply</dt><dd>30 day pack</dd></div>
          </dl>
          <div class="fl-formula__foot"><a href="#build" class="fl__btn fl__btn--dark">Add Everyday</a><button type="button" class="fl__textlink" data-fb-open="fb-label-everyday">View Label</button></div>
        </article>
        <article class="fl-formula fl-formula--performance">
          <span class="fl-formula__tag">Coming Soon</span>
          <h3>Performance</h3>
          <dl>
            <div><dt>Adds</dt><dd>5g creatine</dd></div>
            <div><dt>Base</dt><dd>Clean electrolytes</dd></div>
            <div><dt>Status</dt><dd>In development. Join the list for first access.</dd></div>
          </dl>
          <div class="fl-formula__foot"><button type="button" class="fl__btn" data-fb-open="fb-waitlist">Notify Me</button></div>
        </article>
      </div>
    </div>
  </section>

  <section class="fl__section">
    <div class="fl__wrap fl-ingr">
      <div>
        <p class="fl__eyebrow">Radical transparency</p>
        <h2 class="fl__h2">Everything on the label. Nothing hidden.</h2>
        <p class="fl__lead">Every ingredient is listed by name and source. If you can't read it, it's not in the pack.</p>
        <ul class="fl-nope">
          <li>No proprietary blends</li>
          <li>No fillers you can't pronounce</li>
          <li>No fear-mongering marketing</li>
        </ul>
      </div>
      <div>
        <ul class="fl-ingr__list">
          <li><strong>Pink Himalayan Salt</strong><span>as Ancient Ocean</span></li>
          <li><strong>Magnesium Malate</strong><span>Magnesium</span></li>
          <li><strong>Coconut Water Powder</strong><span>as CocOganic Plus</span></li>
          <li><strong>Potassium Chloride</strong><span>Potassium</span></li>
          <li><strong>Bamboo Fiber</strong><span>Fiber</span></li>
          <li><strong>Organic Lemon Juice Powder</strong><span>Flavor</span></li>
          <li><strong>Monk Fruit + Reb M</strong><span>Sweetened with OnoSweet</span></li>
          <li class="is-energy"><strong>Natural Caffeine</strong><span>From coffee bean. Energy only.</span></li>
          <li class="is-everyday"><strong>Vitamin D3 + K2</strong><span>Menaquinone-7. Everyday only.</span></li>
        </ul>
        <p class="fl-ingr__note">See the full Supplement Facts with <button type="button" class="fl__textlink" data-fb-open="fb-label-energy">Energy</button> or <button type="button" class="fl__textlink" data-fb-open="fb-label-everyday">Everyday</button>.</p>
      </div>
    </div>
  </section>

  <section class="fl__section" style="padding-top:0">
    <div class="fl__wrap">
      <div class="fl-guarantee">
        <div class="fl-guarantee__seal"><div><b>30</b><small>Day<br>Guarantee</small></div></div>
        <div>
          <h2>Love it or it's on us.</h2>
          <p>Not happy for any reason? Contact us within 30 days of delivery and we'll refund the purchase price. No return required.</p>
        </div>
        <a href="#build" class="fl__btn">Try It Risk-Free</a>
      </div>
    </div>
  </section>

  <section class="fl__section fl__section--soft">
    <div class="fl__wrap">
      <div class="fl__center">
        <p class="fl__eyebrow">FAQ</p>
        <h2 class="fl__h2">Questions, answered.</h2>
      </div>
      <div class="fl-faq">
        <details><summary>What's the difference between Energy and Everyday?</summary><p>Both share the same electrolyte base. Energy is a higher-sodium formula with natural caffeine from coffee bean. Everyday is caffeine-free and adds Vitamin D3 and Vitamin K2.</p></details>
        <details><summary>Can I mix formulas and flavors?</summary><p>Yes. Mix any combination of Energy and Everyday in Organic Salty Orange and Organic Salty Watermelon. Rewards are based on the total number of packs in your bundle.</p></details>
        <details><summary>How does Subscribe &amp; Save work?</summary><p>You save 10% on every order and choose delivery every 30, 60, or 90 days. Your subscription renews automatically at the price shown until you cancel, and we email you a reminder before each renewal.</p></details>
        <details><summary>How do I skip, change, or cancel?</summary><p>Log in at livefortified.com and go to My Subscriptions. You can skip, swap flavors, change quantity, or cancel anytime before your next billing date. No calls or emails required. You can also email hello@livefortified.com or call (888) 688-8351.</p></details>
        <details><summary>What is Free Creatine For Life?</summary><p>{{ section.settings.creatine_faq }}</p></details>
        <details><summary>What if I don't like it?</summary><p>Contact us within 30 days of delivery and we'll refund the purchase price. No return required. A refund does not cancel future subscription orders on its own, so cancel from your account if you'd like to stop.</p></details>
        <details><summary>When will my order ship?</summary><p>Orders typically ship within 1 to 3 business days and standard ground delivery usually takes 3 to 7 business days. We ship to all 50 US states and DC.</p></details>
        <details><summary>When is Performance launching?</summary><p>Soon. <button type="button" class="fl__textlink" data-fb-open="fb-waitlist">Join the list</button> and you'll be the first to know.</p></details>
      </div>
    </div>
  </section>

  <section class="fl-final">
    <div class="fl__wrap">
      <h2 class="fl__h2">Read the label. Then drink it.</h2>
      <p>Build your bundle and save 10% on every order.</p>
      <a href="#build" class="fl__btn fl__btn--dark">Build Your Bundle</a>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Fortified landing info",
  "tag": "section",
  "settings": [
    { "type": "textarea", "id": "creatine_faq", "label": "Free Creatine For Life answer", "default": "Keep 3 or more packs on an active subscription and we include our single-ingredient Creatine Monohydrate with your orders at no charge, for as long as your subscription stays at 3+ packs." }
  ],
  "presets": [{ "name": "Fortified landing info" }]
}
{% endschema %}
