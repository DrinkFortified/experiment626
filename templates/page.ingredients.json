    "cards": {
      "type": "ff-ingredients",
      "settings": {
        "anchor": "ingredients",
        "out_anchor": "left-out",
        "out_heading": "What we leave out",
        "out_list": "Proprietary blends\nAdded sugar\nSucralose and aspartame\nSeparately added citric acid\nSynthetic caffeine anhydrous\nSynthetic dyes",
        "note": "Amounts are per serving, as printed on the pack. The label on your pouch is always the final word."
      },
      "blocks": {
        "i0": {
          "type": "ingredient",
          "settings": {
            "name": "Pink Himalayan Salt",
            "amount": "1,200mg sodium",
            "formula": "base",
            "source": "As Ancient Ocean®",
            "why": "Sodium is the electrolyte you lose most in sweat. This salt is the main source of the sodium in every stick."
          }
        },
        "i1": {
          "type": "ingredient",
          "settings": {
            "name": "Magnesium Malate",
            "amount": "150mg magnesium",
            "formula": "base",
            "source": "From 1,000mg magnesium malate",
            "why": "Magnesium rounds out the electrolyte base. The label lists 150mg of magnesium, the amount the malate provides."
          }
        },
        "i2": {
          "type": "ingredient",
          "settings": {
            "name": "Coconut Water Powder",
            "amount": "",
            "formula": "base",
            "source": "CocOganic® Plus, organic coconut water",
            "why": "Organic coconut water powder. It naturally contains minerals and adds taste."
          }
        },
        "i3": {
          "type": "ingredient",
          "settings": {
            "name": "Potassium Chloride",
            "amount": "200mg potassium",
            "formula": "base",
            "source": "Potassium",
            "why": "The potassium in the base. 200mg per stick, as printed on the label."
          }
        },
        "i4": {
          "type": "ingredient",
          "settings": {
            "name": "Organic Lemon Juice Powder",
            "amount": "",
            "formula": "base",
            "source": "Dried organic lemon juice",
            "why": "Citrus character and tartness. Lemon juice naturally contains citric acid; we add none separately."
          }
        },
        "i5": {
          "type": "ingredient",
          "settings": {
            "name": "Organic Flavors",
            "amount": "",
            "formula": "base",
            "source": "Organic Salty Orange or Organic Salty Watermelon",
            "why": "The taste of each pack. Organic flavors, as printed on the label."
          }
        },
        "i6": {
          "type": "ingredient",
          "settings": {
            "name": "Malic Acid",
            "amount": "",
            "formula": "base",
            "source": "Fruit acid",
            "why": "Tartness that balances the salty and the sweet."
          }
        },
        "i7": {
          "type": "ingredient",
          "settings": {
            "name": "Bamboo Fiber",
            "amount": "",
            "formula": "base",
            "source": "Plant fiber",
            "why": "A plant fiber for texture and handling. Small amount, listed in full like everything else."
          }
        },
        "i8": {
          "type": "ingredient",
          "settings": {
            "name": "Reb M, fermented",
            "amount": "",
            "formula": "base",
            "source": "Reb M 95% fermented, as OnoSweet™",
            "why": "A natural, zero-calorie sweetener made through fermentation."
          }
        },
        "i9": {
          "type": "ingredient",
          "settings": {
            "name": "Monk Fruit Extract",
            "amount": "",
            "formula": "base",
            "source": "Monk fruit",
            "why": "Sweetness from monk fruit. With Reb M, it keeps every stick at 0g sugar."
          }
        },
        "i10": {
          "type": "ingredient",
          "settings": {
            "name": "Vitamin D3",
            "amount": "25mcg",
            "formula": "everyday",
            "source": "As cholecalciferol",
            "why": "The form of vitamin D your skin makes from sunlight. In every Everyday stick."
          }
        },
        "i11": {
          "type": "ingredient",
          "settings": {
            "name": "Vitamin K2",
            "amount": "",
            "formula": "everyday",
            "source": "As MK-7",
            "why": "Paired with D3 in every Everyday stick."
          }
        },
        "i12": {
          "type": "ingredient",
          "settings": {
            "name": "Natural Caffeine",
            "amount": "150mg",
            "formula": "energy",
            "source": "From coffee bean",
            "why": "Caffeine from coffee bean, never synthetic caffeine anhydrous. Everyday has none."
          }
        },
        "i13": {
          "type": "ingredient",
          "settings": {
            "name": "Creatine Monohydrate",
            "amount": "5g",
            "formula": "creatine",
            "source": "The only ingredient",
            "why": "One scoop per serving, 45 servings per pouch. Unflavored, so it mixes into water, coffee or your Everyday."
          }
        }
      },
