    "faq": {
      "type": "ff-faq",
      "settings": {
        "heading": "Ingredient",
        "heading_accent": "questions.",
        "anchor": "ingredient-faq",
        "tone": "paper2",
        "schema_markup": true
      },
      "blocks": {
        "q0": {
          "type": "qa",
          "settings": {
            "q": "Is there any sugar?",
            "a": "<p>No. 0g sugar per serving. Everyday and Energy are sweetened with monk fruit extract and Reb M.</p>"
          }
        },
        "q1": {
          "type": "qa",
          "settings": {
            "q": "Why 1,200mg of sodium?",
            "a": "<p>Sodium is the main electrolyte lost in sweat, so it leads the base. If you watch your sodium for a medical reason, talk to your healthcare professional before use.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "q": "Where does the caffeine in Energy come from?",
            "a": "<p>Coffee bean. 150mg per stick, never synthetic caffeine anhydrous. Everyday is caffeine-free.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "Can I mix creatine into Everyday or Energy?",
            "a": "<p>Yes. The creatine is unflavored, so it stirs into water, coffee, a shake or your stick of Everyday or Energy.</p>"
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "q": "Where can I see the full facts panel?",
            "a": "<p>On each product page (tap Read the back on the pouch) and printed on every pack.</p>"
          }
        }
      },
