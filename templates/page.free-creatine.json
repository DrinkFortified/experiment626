      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "q": "How do I get the free creatine?",
            "a": "<p>Subscribe to 3 or more packs of Everyday or Energy, Monthly or Every 3 months. Mix formulas and organic flavors any way you like. A pouch of creatine is added to your box automatically.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "q": "Is it really free every time?",
            "a": "<p>Yes. A pouch ships free with every delivery for as long as you stay subscribed with 3 or more packs. That is the Free Creatine For Life of Subscription.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "What if I drop below 3 packs?",
            "a": "<p>The free pouch comes off your next delivery. Add a pack back and it returns.</p>"
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "q": "Can I skip, pause or cancel?",
            "a": "<p>Anytime, online, in your account. No phone call.</p>"
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "q": "What is in the creatine?",
            "a": "<p>One ingredient: creatine monohydrate. 5g per serving, unflavored, no sweeteners, no fillers.</p>"
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "q": "What is the difference between Energy and Everyday?",
            "a": "<p>Both share the same electrolyte base and 1,200mg sodium. Energy adds 150mg natural caffeine from coffee bean. Everyday is caffeine-free and adds Vitamin D3 and Vitamin K2.</p>"
          }
        }
