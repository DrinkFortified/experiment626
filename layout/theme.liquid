<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-page="{% if template.name == 'index' %}home{% else %}{{ template.name }}{% endif %}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#ffffff">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title }}{% if current_page != 1 %} | {{ 'general.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">{%- endif -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Figtree:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  {{ 'fortified.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <a class="sr" href="#main">{{ 'general.skip' | t }}</a>
  {% sections 'header-group' %}
  <main id="main">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
  {% render 'cart-drawer' %}
  <div class="toast" role="status" aria-live="polite" data-toast></div>
  <script>
    window.FF = {
      routes: { cartAdd: {{ routes.cart_add_url | append: '.js' | json }}, cart: {{ routes.cart_url | append: '.js' | json }}, cartChange: {{ routes.cart_change_url | append: '.js' | json }}, checkout: '/checkout' },
      money: {{ shop.money_format | json }},
      freeShipAt: {{ settings.free_shipping_packs | default: 2 }},
      creatineAt: {{ settings.creatine_packs | default: 3 }},
      text: { empty: {{ 'cart.empty' | t | json }}, perk1: {{ 'cart.perk_ship' | t | json }}, perk2: {{ 'cart.perk_creatine' | t | json }}, done: {{ 'cart.all_unlocked' | t | json }} }
    };
  </script>
  <script src="{{ 'fortified-theme.js' | asset_url }}" defer></script>
</body>
</html>
