<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-page="{% if template.name == 'index' %}home{% else %}{{ template.name }}{% endif %}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#ffffff">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title }}{% if current_page != 1 %} | {{ 'general.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">{%- else -%}<link rel="icon" type="image/png" href="{{ 'ff-shield.png' | asset_url }}"><link rel="apple-touch-icon" href="{{ 'ff-shield.png' | asset_url }}">{%- endif -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Figtree:wght@400;500;600;700;800;900&family=Permanent+Marker&display=swap" rel="stylesheet">
  {%- render 'ff-seo' -%}
  {{ 'fortified.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <a class="sr" href="#main">{{ 'general.skip' | t }}</a>
  {% sections 'header-group' %}
  <main id="main">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
  {% render 'cart-drawer' %}
  <div class="toast" role="status" aria-live="polite" data-toast></div>
  <script>
    window.FF = {
      routes: { cartAdd: {{ routes.cart_add_url | append: '.js' | json }}, cart: {{ routes.cart_url | append: '.js' | json }}, cartChange: {{ routes.cart_change_url | append: '.js' | json }}, cartUpdate: {{ routes.cart_update_url | append: '.js' | json }}, checkout: '/checkout' },
      money: {{ shop.money_format | json }},
      freeShipAt: {{ settings.free_shipping_packs | default: 2 }},
      creatineAt: {{ settings.creatine_packs | default: 3 }},
      volumeTiers: {{ settings.volume_tiers | json }},
      quick: {%- render 'ff-quickbuy-data' -%},
      {%- liquid
        assign cp = settings.creatine_product
        if cp == blank
          assign cp = all_products['creatine']
        endif
        assign cm = ''
        assign cq = ''
        for g in cp.selling_plan_groups
          for p in g.selling_plans
            assign pn = p.name | downcase
            if pn contains 'quarter' or pn contains '90' or pn contains '3 month'
              assign cq = p.id
            else
              assign cm = p.id
            endif
          endfor
        endfor
      -%}
      {%- liquid
        assign up = settings.creatine_upsell_product
        if up == blank
          assign up = all_products['creatine-v2']
        endif
        assign up_plan = ''
        for g in up.selling_plan_groups
          for p in g.selling_plans
            assign pn = p.name | downcase
            if pn contains '90' or pn contains 'quarter' or pn contains '3 month'
              assign up_plan = p.id
            endif
          endfor
        endfor
        assign up_pct = settings.creatine_upsell_pct | default: 50
      -%}
      upsell: {% if settings.creatine_upsell and up.id and up.first_available_variant and up_plan != '' %}{ id: {{ up.first_available_variant.id }}, plan: {{ up_plan | json }}, price: {{ up.first_available_variant.price }}, pct: {{ up_pct }} }{% else %}null{% endif %},
      creatine: {% if settings.creatine_auto and cp.id and cp.first_available_variant %}{ id: {{ cp.first_available_variant.id }}, monthly: {{ cm | json }}, quarterly: {{ cq | json }} }{% else %}null{% endif %},
      text: { empty: {{ 'cart.empty' | t | json }}, perk1: {{ 'cart.perk_ship' | t | json }}, perk2: {{ 'cart.perk_creatine' | t | json }}, done: {{ 'cart.all_unlocked' | t | json }}, creatine: {{ 'cart.creatine_line' | t | json }} }
    };
  </script>
  <script src="{{ 'fortified-theme.js' | asset_url }}" defer></script>
</body>
</html>
